static inline __attribute__((always_inline))
float3 SampleScene(thread const float2& uv, texture2d<float> sceneTexture, sampler sceneSampler)
{
    return sceneTexture.sample(sceneSampler, uv).xyz;
}

static inline __attribute__((always_inline))
