        {
            float2 param_5 = uv + ((_201[tap] * _74.texel) * 4.0);
            float3 param_6 = SampleScene(param_5, sceneTexture, sceneSampler);
            glow += (Highlight(param_6) * 0.100000001490116119384765625);
