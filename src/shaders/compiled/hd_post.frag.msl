    float3 sharpened = center.xyz + ((center.xyz - ((((north + south) + east) + west) * 0.25)) * _74.sharpness);
    float3 color = fast::clamp(sharpened, low - float3(0.02500000037252902984619140625), high + float3(0.02500000037252902984619140625));
    if (_74.bloom > 0.0)
    {
