<div class="dye-section dye-materials"><h3>POCIONES REQUERIDAS</h3><div class="dye-bottles"><div><img id="dye_potion_0"/><span>ROJA {{red_count}}</span></div><div><img id="dye_potion_1"/><span>VERDE {{green_count}}</span></div><div><img id="dye_potion_2"/><span>AZUL {{blue_count}}</span></div></div></div></div></div>
