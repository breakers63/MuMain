<rml><head><title>Color de equipo</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_item_dye.rcss"/></head>
<!-- bound-geometry: cursor_x, cursor_y and hue_x express the chosen HSV color, not panel layout. -->
<body data-model="paris_item_dye"><div id="panel" class="dye-panel" data-class-busy="busy">
<div class="dye-frame dye-tl"></div><div class="dye-frame dye-t"></div><div class="dye-frame dye-tr"></div><div class="dye-frame dye-l"></div><div class="dye-frame dye-r"></div><div class="dye-frame dye-bl"></div><div class="dye-frame dye-b"></div><div class="dye-frame dye-br"></div>
<div class="dye-top"><h2>COLOR DE EQUIPO</h2><button class="btn dye-close" data-event-click="dye_close">X</button></div>
<div class="dye-modes"><button class="btn" data-class-active="!multiple" data-event-click="dye_mode(false)">UNA PIEZA</button><button class="btn" data-class-active="multiple" data-event-click="dye_mode(true)">VARIAS PIEZAS</button></div>
<div class="dye-pieces"><button class="dye-piece" data-class-selected="pieces[0].selected" data-class-focused="pieces[0].focused" data-event-click="dye_piece(0)"><div class="dye-hint dye-hint-helm" data-if="!pieces[0].selected"></div><img id="dye_piece_0"/><span>CASCO</span><b data-if="pieces[0].selected">+</b></button><button class="dye-piece" data-class-selected="pieces[1].selected" data-class-focused="pieces[1].focused" data-event-click="dye_piece(1)"><div class="dye-hint dye-hint-armor" data-if="!pieces[1].selected"></div><img id="dye_piece_1"/><span>PECHERA</span><b data-if="pieces[1].selected">+</b></button><button class="dye-piece" data-class-selected="pieces[2].selected" data-class-focused="pieces[2].focused" data-event-click="dye_piece(2)"><div class="dye-hint dye-hint-pants" data-if="!pieces[2].selected"></div><img id="dye_piece_2"/><span>PANTALON</span><b data-if="pieces[2].selected">+</b></button><button class="dye-piece" data-class-selected="pieces[3].selected" data-class-focused="pieces[3].focused" data-event-click="dye_piece(3)"><div class="dye-hint dye-hint-gloves" data-if="!pieces[3].selected"></div><img id="dye_piece_3"/><span>GUANTES</span><b data-if="pieces[3].selected">+</b></button><button class="dye-piece" data-class-selected="pieces[4].selected" data-class-focused="pieces[4].focused" data-event-click="dye_piece(4)"><div class="dye-hint dye-hint-boots" data-if="!pieces[4].selected"></div><img id="dye_piece_4"/><span>BOTAS</span><b data-if="pieces[4].selected">+</b></button></div><div class="dye-count">{{count}}</div>
<div class="dye-body"><div class="dye-left dye-section"><h3>VISTA PREVIA</h3><img id="dye_preview" class="dye-preview"/>
<div class="dye-step"><button class="btn" data-event-click="dye_step(-1)">&lt; PREVIO</button><button class="btn" data-event-click="dye_step(1)">SIGUIENTE &gt;</button></div>
<div class="dye-compare"><div><span>Original</span><div class="dye-compare-box"><img id="dye_original"/></div></div><div><span>Nuevo</span><div class="dye-compare-box"><img id="dye_new"/></div></div></div></div>
<div class="dye-right"><div class="dye-section dye-colors"><h3>ELIGE EL COLOR</h3>
<div id="dye_sv" class="dye-sv" data-style-background-color="hue_color"><div class="dye-white"></div><div class="dye-black"></div><div class="dye-cursor" data-style-left="cursor_x" data-style-top="cursor_y"></div></div>
<div id="dye_hue" class="dye-hue"><div class="dye-hue-cursor" data-style-left="hue_x"></div></div>
<div class="dye-swatch-grid"><div class="dye-swatch-row"><button class="dye-swatch" data-style-background-color="palette[0].color" data-event-click="dye_swatch(palette[0].value)"></button><button class="dye-swatch" data-style-background-color="palette[1].color" data-event-click="dye_swatch(palette[1].value)"></button><button class="dye-swatch" data-style-background-color="palette[2].color" data-event-click="dye_swatch(palette[2].value)"></button><button class="dye-swatch" data-style-background-color="palette[3].color" data-event-click="dye_swatch(palette[3].value)"></button><button class="dye-swatch" data-style-background-color="palette[4].color" data-event-click="dye_swatch(palette[4].value)"></button><button class="dye-swatch" data-style-background-color="palette[5].color" data-event-click="dye_swatch(palette[5].value)"></button><button class="dye-swatch" data-style-background-color="palette[6].color" data-event-click="dye_swatch(palette[6].value)"></button><button class="dye-swatch" data-style-background-color="palette[7].color" data-event-click="dye_swatch(palette[7].value)"></button><button class="dye-swatch" data-style-background-color="palette[8].color" data-event-click="dye_swatch(palette[8].value)"></button><button class="dye-swatch" data-style-background-color="palette[9].color" data-event-click="dye_swatch(palette[9].value)"></button><button class="dye-swatch" data-style-background-color="palette[10].color" data-event-click="dye_swatch(palette[10].value)"></button><button class="dye-swatch" data-style-background-color="palette[11].color" data-event-click="dye_swatch(palette[11].value)"></button><button class="dye-swatch" data-style-background-color="palette[12].color" data-event-click="dye_swatch(palette[12].value)"></button><button class="dye-swatch" data-style-background-color="palette[13].color" data-event-click="dye_swatch(palette[13].value)"></button></div><div class="dye-swatch-row"><button class="dye-swatch" data-style-background-color="palette[14]