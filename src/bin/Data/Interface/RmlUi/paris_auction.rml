<rml><head><title>Subastas</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_auction.rcss"/></head><body data-model="paris_auction"><div id="panel" class="paris-auction" data-class-publishing="tab == 1"><div class="auction-frame frame-tl"></div><div class="auction-frame frame-t"></div><div class="auction-frame frame-tr"></div><div class="auction-frame frame-l"></div><div class="auction-frame frame-r"></div><div class="auction-frame frame-bl"></div><div class="auction-frame frame-b"></div><div class="auction-frame frame-br"></div><div class="auction-header"></div><div class="auction-section-title" data-if="tab != 0"><span data-if="tab == 1">Publicar</span><span data-if="tab == 2">Mis ofertas</span><span data-if="tab == 3">Entregas</span><span data-if="tab == 4">Mis subastas</span></div><div id="frame_corner_close" data-event-click="paris_auction_close"></div><div class="auction-navigation"><div class="auction-tab tab-0" data-class-active="tab == 0" data-event-click="paris_auction_tab(0)"><span>Subastas</span></div><div class="auction-tab tab-1" data-class-active="tab == 1" data-event-click="paris_auction_tab(1)"><span>Publicar</span></div><div class="auction-tab tab-2" data-class-active="tab == 2" data-event-click="paris_auction_tab(2)"><span>Mis ofertas</span></div><div class="auction-tab tab-3" data-class-active="tab == 3" data-event-click="paris_auction_tab(3)"><span>Entregas</span></div><div class="auction-tab tab-4" data-class-active="tab == 4" data-event-click="paris_auction_tab(4)"><span>Mis subastas</span></div></div><div class="auction-searchbar" data-if="tab == 0"><input class="auction-query" type="text" maxlength="64" data-value="query"/><span class="auction-placeholder" data-if="query == ''">⌕ Buscar item...</span><select class="auction-filter" data-value="group" data-event-change="auction_filter"><option value="255">Todos</option><option value="16">Armas</option><option value="6">Escudos</option><option value="17">Armaduras</option><option value="20">Alas / capas</option><option value="18">Mascotas</option><option value="19">Scrolls / poderes</option><option value="21">Accesorios</option></select><span class="auction-filter-chevron">⌄</span><div class="auction-refresh" data-event-click="paris_auction_refresh"><span>Buscar</span></div></div><div class="auction-subtabs" data-if="tab >= 2"><div data-class-active="subtab == 0" data-event-click="auction_subtab(0)"><span data-if="tab == 2">Ofertas realizadas</span><span data-if="tab == 3">Items por recibir</span><span data-if="tab == 4">Publicaciones activas</span></div><div data-class-active="subtab == 1" data-event-click="auction_subtab(1)"><span data-if="tab == 2">Historial de compras</span><span data-if="tab == 3">Monedas por recibir</span><span data-if="tab == 4">Historial</span></div></div><div class="auction-publish-fields" data-if="tab == 1"><label>Precio<input type="text" data-value="price_input" maxlength="10"/></label><label>Compra inmediata<input type="text" data-value="buy_now_input" maxlength="10"/></label><div class="auction-select" data-event-click="paris_auction_currency"><span>{{currency_label}}</span></div><div class="auction-select" data-event-click="paris_auction_duration"><span>{{duration_label}}</span></div></div><div class="auction-table"><div class="auction-grid"><div class="grid-row"></div><div class="grid-row"></div><div class="grid-row"></div><div class="grid-row"></div><div class="grid-row"></div><div class="grid-row"></div><div class="grid-row"></div><div class="grid-column c0"></div><div class="grid-column c1"></div><div class="grid-column c2"></div><div class="grid-column c3"></div><div class="grid-column c4"></div><div class="grid-column c5"></div></div><div class="auction-head"><span class="cell-icon">Item</span><span class="cell-name">Nombre</span><span class="cell-options">Opciones</span><span class="cell-price">Precio</span><span class="cell-seller">Vendedor</span><span class="cell-time">Tiempo</span></div><div class="auction-list"><div class="auction-row" data-for="row : rows"><img class="auction-item-image"/><span class="cell-name">{{row.name}}</span><span class="cell-options">{{row.options}}</span><span class="cell-price">{{row.price}}</span><span class="cell-seller">{{row.seller}}</span><span class="cell-time">{{row.time}}</span><div class="auction-action" data-if="row.action != ''" data-class-disabled="!row.enabled" data-event-click="paris_auction_action(row.index)"><span>{{row.action}}</span></div></div></div><div class="auction-empty" data-if="empty">No hay resultados para esta sección.</div></div><div class="auction-status">{{status}}</div><div class="auction-pages"><div class="auction-page-button" data-event-click="paris_auction_previous"><span>‹</span></div><span>{{page}} / {{page_count}}</span><div class="auction-page-button" data-event-click="paris_auction_next"><span>›</span></div></div></div></body></rml>