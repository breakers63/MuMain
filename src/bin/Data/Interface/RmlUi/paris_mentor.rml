<rml><head><title>Mentoría</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_mentor.rcss"/></head>
<body data-model="paris_mentor"><div id="panel" class="paris-mentor" data-class-find="tab == 1" data-class-rewards="tab == 2" data-class-history="tab == 3">
<div class="mentor-close" data-event-click="mentor_close"></div>
<div class="mentor-tabs" data-if="mentor"><div class="tab tab-novices" data-class-selected="tab == 0" data-event-click="mentor_tab(0)">Novatos</div><div class="tab tab-rewards" data-class-selected="tab == 2" data-event-click="mentor_tab(2)">Recompensas</div><div class="tab tab-history" data-class-selected="tab == 3" data-event-click="mentor_tab(3)">Historial</div></div>
<div class="mentor-tabs novice-tabs" data-if="!mentor"><div class="tab tab-find" data-class-selected="tab == 1" data-event-click="mentor_tab(1)">Buscar mentor</div><div class="tab tab-history" data-class-selected="tab == 3" data-event-click="mentor_tab(3)">Historial</div></div>
<div class="mentor-loading" data-if="!ready">{{status}}</div>
<div class="mentor-content" data-class-pending="!ready">
<div class="mentor-header"><div class="header-name">{{name}}</div><div class="header-points">Puntos: {{points}}</div><div class="header-graduated">Graduados: {{graduated}}</div><div class="header-daily">Hoy: {{daily}}</div><div class="header-bonus">EXP: +{{bonus}}%</div></div>
<div class="mentor-home" data-if="tab == 0">
<div class="home-heading">Solicitudes y novatos</div><div class="summary-heading">Resumen</div>
<div class="home-person" data-for="person, i : people" data-class-home-person-0="i == 0" data-class-home-person-1="i == 1" data-class-home-person-2="i == 2" data-class-home-person-3="i == 3" data-class-home-person-4="i == 4" data-class-home-person-5="i == 5" data-class-home-person-6="i == 6" data-event-click="mentor_person(person.index)"><div class="person-portrait" data-class-portrait-0="person.portrait == 'portrait-0'" data-class-portrait-1="person.portrait == 'portrait-1'" data-class-portrait-2="person.portrait == 'portrait-2'" data-class-portrait-3="person.portrait == 'portrait-3'" data-class-portrait-4="person.portrait == 'portrait-4'" data-class-portrait-5="person.portrait == 'portrait-5'" data-class-class-3="person.portrait == 'class-3'" data-class-class-4="person.portrait == 'class-4'" data-class-class-5="person.portrait == 'class-5'"></div><span class="person-name">{{person.name}}</span><span class="person-detail">{{person.detail}}</span><span class="person-value">{{person.value}} resets</span><span class="person-extra">{{person.extra}}</span></div>
<div class="home-accept action" data-class-disabled="!canAccept" data-event-click="mentor_accept">Aceptar</div><div class="home-reject action" data-class-disabled="!canAccept" data-event-click="mentor_reject">Rechazar</div>
<div class="active-count">Novatos activos: {{active}}</div><!-- bound-geometry: activeWidth is the current active novice count divided by the server maximum, a live progress gauge. --><div class="active-track"><div class="active-fill" data-style-width="activeWidth"></div></div>
<div class="summary-points-label">Puntos</div><div class="summary-points-value">{{points}}</div><div class="summary-graduated-label">Graduados</div><div class="summary-graduated-value">{{graduated}}</div><div class="summary-hours-label">Horas en party</div><div class="summary-hours-value">{{hours}} h</div><div class="summary-progress-label">Progreso</div><div class="summary-progress-value">{{progress}}%</div>
<div class="recent-heading">Actividad reciente</div><div class="home-recent"><div class="recent-row" data-for="entry : recent"><span>{{entry.name}}</span><span class="recent-age">{{entry.detail}}</span></div></div>
<div class="home-prev action" data-event-click="mentor_page(-1)">▲</div><div class="home-next action" data-event-click="mentor_page(1)">▼</div>
</div>
<div class="mentor-find" data-if="tab == 1">
<div class="find-role">Rol: {{role}}</div><div class="find-assigned">Mentor: {{assigned}}</div><div class="find-requests">Solicitudes: {{requests}}</div><div class="find-heading">Mentores disponibles</div><div class="top-heading">Top mentores</div>
<input class="mentor-query" type="text" maxlength="10" data-value="query"/><span class="query-placeholder" data-if="query == ''">Buscar por nombre...</span><div class="search-button action" data-event-click="mentor_search">Buscar</div><div class="reset-filter action" data-event-click="mentor_resets">+{{reset}} resets</div>
<div class="find-people"><div class="find-person" data-for="person : people"><div class="person-portrait" data-class-portrait-0="person.portrait == 'portrait-0'" data-class-portrait-1="person.portrait == 'portrait-1'" data-class-portrait-2="person.portrait == 'portrait-2'" data-class-portrait-3="person.portrait == 'portrait-3'" data-class-portrait-4="person.portrait == 'portrait-4'" data-class-portrait-5="person.portrait == 'portrait-5'" data-class-class-3="person.portrait == 'class-3'" data-class-class-4="person.portrait == 'class-4'" data-class-class-5="person.portrait == 'class-5'"></div><span class="person-name">{{person.name}}</span><span class="person-detail">{{person.detail}}</span><span class="person-value">{{person.value}}</span><div class="person-action action" data-class-disabled="!person.enabled" data-event-click="mentor_person(person.index)">{{person.action}}</div></div></div>
<div class="top-people"><div class="top-person" data-for="person : top"><div class="person-portrait" data-class-portrait-0="person.portrait == 'portrait-0'" data-class-portrait-1="person.portrait == 'portrait-1'" data-class-portrait-2="person.portrait == 'portrait-2'" data-class-portrait-3="person.portrait == 'portrait-3'" data-class-portrait-4="person.portrait == 'portrait-4'" data-class-portrait-5="person.portrait == 'portrait-5'" data-class-class-3="person.portrait == 'class-3'" data-class-class-4="person.portrait == 'class-4'" data-class-class-5="person.portrait == 'class-5'"></div><span class="person-name">{{person.name}}</span><span class="person-detail">{{person.detail}}</span><span class="person-extra">{{person.extra}}</span><span class="person-value">Graduados<br/>{{person.value}}</span></div></div>
<div class="find-prev action" data-event-click="mentor_page(-1)">Anterior</div><div class="find-next action" data-event-click="mentor_page(1)">Siguiente</div><div class="find-page">{{page}} / {{pages}}</div><div data-if="canCancel" class="link-cancel action" data-event-click="mentor_link_cancel">Cancelar solicitud</div>
</div>
<div class="mentor-offers" data-if="tab == 2"><div class="mentor-offer" data-for="offer, i : offers" data-class-offer-0="i == 0" data-class-offer-1="i == 1" data-class-offer-2="i == 2" data-class-offer-3="i == 3" data-class-offer-4="i == 4" data-class-offer-5="i == 5"><div class="offer-name">{{offer.name}}</div><img class="mentor-reward-item"/><div class="offer-detail">{{offer.detail}}</div><div class="offer-cost">{{offer.value}} puntos</div><div class="offer-redeem action" data-class-disabled="!offer.enabled" data-event-click="mentor_redeem(offer.index)">{{offer.action}}</div></div><div class="offers-prev action" data-event-click="mentor_page(-1)">Anterior</div><div class="offers-next action" data-event-click="mentor_page(1)">Siguiente</div></div>
<div class="mentor-history" data-if="tab == 3"><div class="history-heading">Historial</div><div class="detail-heading">Detalle del historial</div>
<div class="history-filter filter-all action" data-event-click="mentor_filter(0)">Todos</div><div class="history-filter filter-completed action" data-event-click="mentor_filter(1)">Completados</div><div class="history-filter filter-ended action" data-event-click="mentor_filter(2)">Finalizados</div><div class="history-filter filter-rewards action" data-event-click="mentor_filter(3)">Recompensas</div>
<div class="history-head"><span class="history-date">Fecha</span><span class="history-name">Novato</span><span class="history-kind">Actividad</span><span class="history-points">Puntos</span></div>
<div class="history-rows"><div class="history-row" data-for="entry : history" data-event-click="mentor_history(entry.index)"><span class="history-date">{{entry.extra}}</span><span class="history-name">{{entry.name}}</span><span class="history-kind">{{entry.detail}}</span><span class="history-points">{{entry.value}}</span></div></div>
<div class="history-prev action" data-event-click="mentor_page(-1)">&lt;</div><div class="history-next action" data-event-click="mentor_page(1)">&gt;</div><div class="history-page">{{page}} / {{pages}}</div>
<div class="detail-name">{{detailName}}</div><div class="detail-mentor">{{detailMentor}}</div><div class="detail-state"><span>{{detailState}}</span></div><div class="history-details"><div class="detail-row" data-for="entry : details"><span>{{entry.name}}</span><span class="detail-value">{{entry.detail}}</span></div></div><div class="detail-recent-heading">Actividad reciente</div><div class="detail-event">{{detailEvent}}</div><div class="detail-date">{{detailDate}}</div><div class="detail-points">{{detailPoints}} puntos</div><div class="history-close action" data-event-click="mentor_close"><span>Cerrar</span></div>
</div>
<div class="mentor-status">{{status}}</div>
</div>
<div class="mentor-confirm-shade" data-if="confirm"><div class="mentor-confirm"><div class="confirm-title">Confirmar canje</div><div class="confirm-description">{{confirmText}}</div><div class="confirm-accept action" data-event-click="mentor_confirm">Confirmar</div><div class="confirm-cancel action" data-event-click="mentor_cancel">Cancelar</div></div></div>
</div></body></rml>