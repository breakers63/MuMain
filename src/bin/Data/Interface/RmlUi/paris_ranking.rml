<rml><head><title>Ranking</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_ranking.rcss"/></head><!-- bound-geometry: mission progress is the fraction received from the server. -->
<body data-model="paris_ranking"><div id="panel" class="paris-ranking" data-class-guilds="tab == 1" data-class-missions="tab == 2"><div class="ranking-background" data-attr-aria-label="title"></div>
<div id="frame_corner_close" class="ranking-close" data-event-click="paris_ranking_close">×</div><div class="ranking-tabs"><div class="ranking-tab tab-reset" data-class-active="tab == 0" data-event-click="paris_ranking_tab(0)">RESET</div><div class="ranking-tab tab-guild" data-class-active="tab == 1" data-event-click="paris_ranking_tab(1)">CLANES</div><div class="ranking-tab tab-mission" data-class-active="tab == 2" data-event-click="paris_ranking_tab(2)">MISIONES</div></div>
<div class="ranking-privacy" data-if="tab != 2" data-event-click="ranking_privacy"><span>MI EQUIPO</span><span class="privacy-state" data-if="preferenceReady"><span data-if="ownPublic">● PÚBLICO</span><span data-if="!ownPublic">● PRIVADO</span></span></div>
<div class="ranking-main" data-if="tab != 2"><input class="ranking-search" type="text" maxlength="32" data-value="query"/><span class="ranking-placeholder" data-if="query == ''"><span data-if="tab == 0">Buscar personaje...</span><span data-if="tab == 1">Buscar clan...</span></span><div class="ranking-list-head"><span><span data-if="tab == 0">PERSONAJE</span><span data-if="tab == 1">CLAN</span></span><span data-if="tab == 0">RESETS</span><span data-if="tab == 1">PUNTOS</span></div><div class="ranking-rows"><div class="ranking-row" data-for="row : rows" data-class-selected="selected == row.index" data-event-click="ranking_select(row.index)"><span class="ranking-position">{{row.rank}}</span><span class="ranking-row-name">{{row.name}}</span><span class="ranking-value">{{row.value}}</span></div><div class="ranking-empty" data-if="empty">{{status}}</div></div><div class="ranking-prev" data-event-click="paris_ranking_previous">‹ ANTERIOR</div><div class="ranking-page">{{page}} / {{page_count}}</div><div class="ranking-next" data-event-click="paris_ranking_next">SIGUIENTE ›</div>
<div class="ranking-profile" data-if="tab == 0"><div class="ranking-profile-name">{{name}}</div><div class="ranking-profile-class">{{characterClass}} - {{guild}}</div><div class="ranking-visibility">{{visibility}}</div><img id="ranking-character"/><span class="ranking-character-label">{{characterClass}} - LV {{level}}</span><div class="ranking-equipment"><div class="ranking-equipment-card" data-for="item : equipment" data-class-card-0="item.slot == 0" data-class-card-1="item.slot == 1" data-class-card-2="item.slot == 2" data-class-card-3="item.slot == 3" data-class-card-4="item.slot == 4" data-class-card-5="item.slot == 5" data-class-card-6="item.slot == 6" data-class-card-7="item.slot == 7" data-class-card-8="item.slot == 8" data-class-card-9="item.slot == 9" data-class-card-10="item.slot == 10" data-class-card-11="item.slot == 11"><img class="ranking-item"/><span class="ranking-item-label">{{item.label}}</span><span class="ranking-item-name">{{item.name}}</span></div></div><div class="ranking-stats"><div><strong>NIVEL</strong><br/>{{level}}</div><div><strong>RESET</strong><br/>{{resets}}</div><div><strong>TOTAL STATS</strong><br/>{{totalStats}}</div><div><strong>CLASE</strong><br/>{{characterClass}}</div></div></div>
<div class="ranking-guild" data-if="tab == 1"><div class="ranking-guild-mark"><span data-for="cell : mark" data-style-background-color="cell.color"></span></div><div class="ranking-guild-name">{{guild}}</div><div class="ranking-guild-master">Master: {{name}} · GUILD ACTIVO</div><div class="ranking-guild-metrics"><span>PUESTO<br/>#{{selected + 1}}</span><span>PUNTOS<br/>{{guildScore}}</span><span>MIEMBROS<br/>{{guildMembers}}</span></div><div class="ranking-members"><div class="ranking-member" data-for="member : members" data-event-click="ranking_member(member.index)"><div class="ranking-portrait" data-class-class-0="member.character_class == 0" data-class-class-1="member.character_class == 1" data-class-class-2="member.character_class == 2" data-class-class-3="member.character_class == 3" data-class-class-4="member.character_class == 4" data-class-class-5="member.character_class == 5" data-class-class-6="member.character_class == 6"></div><span class="ranking-member-name">{{member.name}}</span><span class="ranking-member-class">{{member.detail}}</span></div></div><span class="ranking-members-count">{{guildMembers}} TOTAL</span><div class="ranking-member-pager"><span data-event-click="ranking_member_page(-1)">‹ ANTERIOR</span><span>{{memberPage}} / {{memberPages}}</span><span data-event-click="ranking_member_page(1)">SIGUIENTE ›</span></div><div class="ranking-member-card"><div class="ranking-selected-portrait ranking-portrait" data-class-class-0="memberClass == 'Dark Wizard' || memberClass == 'Soul Master' || memberClass == 'Grand Master'" data-class-class-1="memberClass == 'Dark Knight' || memberClass == 'Blade Knight' || memberClass == 'Blade Master'" data-class-class-2="memberClass == 'Fairy Elf' || memberClass == 'Muse Elf' || memberClass == 'High Elf'" data-class-class-3="memberClass == 'Magic Gladiator' || memberClass == 'Duel Master'" data-class-class-4="memberClass == 'Dark Lord' || memberClass == 'Lord Emperor'" data-class-class-5="memberClass == 'Summoner' || memberClass == 'Bloody Summoner' || memberClass == 'Dimension Master'"></div><div class="ranking-member-title">{{memberName}}</div><div class="ranking-member-subtitle">{{memberClass}}</div><div class="ranking-member-rank">{{memberRank}}</div><div class="ranking-member-level">NIVEL<br/>{{memberLevel}}</div><div class="ranking-member-resets">RESET<br/>{{memberResets}}</div><div class="ranking-member-stats">TOTAL STATS <span>{{memberStats}}</span></div><div class="ranking-member-attributes"><div>Fuerza<span>{{strength}}</span></div><div>Agilidad<span>{{agility}}</span></div><div>Vitalidad<span>{{vitality}}</span></div><div>Energía<span>{{energy}}</span></div></div><div class="ranking-member-online">{{memberOnline}}</div><div class="ranking-member-details"><div>Clase<span>{{memberClass}}</span></div><div>Guild<span>{{guild}}</span></div><div>Posición personal<span>{{memberRank}}</span></div><div>Detalles<span>{{visibility}}</span></div></div></div></div></div>
<div class="ranking-missions" data-if="tab == 2"><div class="ranking-mission-back"></div><div class="mission-list-heading">MISIONES</div><input class="mission-search" type="text" maxlength="64" data-value="query"/><span class="mission-search-placeholder" data-if="query == ''">Buscar misión...</span><div class="mission-list"><div class="mission-row" data-attr-data-index="mission.index" data-for="mission : missions" data-class-selected="missionSelected == mission.index" data-event-click="ranking_mission(mission.index)"><span class="mission-rank">{{mission.rank}}</span><img class="mission-monster-small"/><span class="mission-name">{{mission.name}}</span><span class="mission-objective">{{mission.detail}}</span><span class="mission-reward-icon"></span><span class="mission-reward-count">{{mission.value}}</span><span class="mission-reward-name">Paris Coins</span></div></div><div class="mission-detail"><div class="mission-title">{{missionName}}</div><img id="mission-monster-large" class="mission-monster-large"/><div class="mission-objective-box"><strong>⚔ OBJETIVO</strong><br/>{{objective}}</div><div class="mission-reward-box"><strong>PREMIO</strong><br/>{{reward}}</div><div class="mission-progress-box"><strong>TU AVANCE</strong><span>{{progress}}</span><div class="mission-progress-track"><div data-style-width="progressWidth"></div></div></div><div class="mission-ranking-title">RANKING DE MISIONES</div><div class="mission-ranking-head"><span>PUESTO</span><span>JUGADOR</span><span>MISIONES</span></div><div class="mission-ranking-list"><div class="mission-ranking-row" data-for="entry : missionRanks"><span>{{entry.rank}}</span><span>{{entry.name}}</span><span>{{entry.detail}}</span></div></div></div></div>
</div></body></rml>