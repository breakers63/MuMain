<rml><head><title>Activity Logs</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_activity_log.rcss"/></head>
<body data-model="paris_activity_log"><div id="panel" class="activity-panel" data-class-kills="kills" data-class-posts="!kills" data-event-mousewheel="activity_wheel">
<div class="activity-background" data-attr-aria-label="title"></div><div class="activity-cover cover-t"></div><div class="activity-cover cover-b"></div><div class="activity-cover cover-l"></div><div class="activity-cover cover-r"></div><div class="activity-border border-t"></div><div class="activity-border border-b"></div><div class="activity-border border-l"></div><div class="activity-border border-r"></div>
<div class="activity-all" data-class-active="all" data-event-click="activity_filter(true)"></div><div class="activity-secondary" data-class-active="!all" data-event-click="activity_filter(false)"></div>
<input class="activity-search" type="text" maxlength="40" data-value="query"/><span class="activity-placeholder" data-if="query == ''"><span data-if="kills">Buscar personaje o mapa...</span><span data-if="!kills">Buscar objeto...</span></span><span class="activity-count">{{count}} REGISTROS</span>
<div class="activity-row" data-for="row : rows" data-class-slot-0="row.slot == 0" data-class-slot-1="row.slot == 1" data-class-slot-2="row.slot == 2" data-class-slot-3="row.slot == 3"><span class="activity-time">{{row.time}}</span><div data-if="kills"><span class="activity-actor">{{row.actor}}</span><span class="activity-winner" data-if="row.winner"></span><span class="activity-defeat" data-if="!row.winner"></span><span class="activity-map-icon" data-class-map-0="row.map_tile == 0" data-class-map-1="row.map_tile == 1" data-class-map-2="row.map_tile == 2" data-class-map-3="row.map_tile == 3"></span><span class="activity-map">{{row.map}}</span></div><div data-if="!kills"><span class="activity-post-badge"></span><span class="activity-item-frame"></span><img class="activity-item"/><span class="activity-description">{{row.description}}</span></div></div>
<div class="activity-empty" data-if="empty">Sin registros en esta sesión.</div>
<div class="activity-scroll-up" data-event-click="activity_step(-1)"></div><div class="activity-scroll-down" data-event-click="activity_step(1)"></div><input class="activity-scroll" data-style---thumb-height="thumb" type="range" orientation="vertical" min="0" step="1" data-attr-max="maximum" data-value="first" data-attrif-disabled="maximum == 0"/><div class="activity-footer-mask mask-left"></div><div class="activity-footer-mask mask-right"></div><button class="activity-prev" data-event-click="activity_page(-1)"><span>‹ ANTERIOR</span></button><button class="activity-next" data-event-click="activity_page(1)"><span>SIGUIENTE ›</span></button><span class="activity-status">{{status}}</span><button class="activity-close" data-event-click="paris_activity_close"><span>CERRAR</span></button>
</div></body></rml>