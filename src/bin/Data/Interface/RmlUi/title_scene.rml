<rml>
<head>
	<title>Title Loading Bar</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="title_scene.rcss"/>
</head>
<body>
    <div class="paris-loading-art"></div>
	<!-- RmlUi's built-in <progress> element, replacing CGaugeBar; C++ calls SetValue()/SetMax()
	     on it directly, no data-model binding. -->
	<progress id="gauge_fill" class="gauge-fill" direction="right" value="0" max="1"/>
</body>
</rml>
