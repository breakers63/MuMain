<rml>
<head>
	<title>Character Info</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="docked_panel_frame.rcss"/>
	<link type="text/rcss" href="character_info.rcss"/>
    <link type="text/rcss" href="paris_stat_allocation.rcss"/>
</head>
<body>
	<!-- The workspace slot places #panel and sets its scale and --root-scale
	     (CObject::GetPlacedDocument()); the panel lays out in reference px.

	     Text leaves render at the native text renderer's size: text_px is the physical size the
	     native client draws at for the active transform (it grows more slowly than the panel), and
	     .counter-scaled cancels #panel's scale so the glyphs are rasterised at that size instead of
	     being enlarged. Positions and box
	     widths stay in reference px; each leaf's transform-origin (character_info.rcss) keeps it
	     anchored to the edge or centre its text is aligned to. -->
	<div id="panel" data-model="character_info">
		<div class="frame-piece frame-top"></div>
		<div class="frame-piece frame-left"></div>
		<div class="frame-piece frame-right"></div>
		<div class="frame-piece frame-bottom"></div>

		<!-- The header leaves centre in a box as wide as #panel: counter-scaled, it must be
		     --root-scale times wider and shifted back by half the growth (character_info.rcss), or a
		     long server name wraps instead of staying centred on one line. -->
		<span class="counter-scaled" id="name" data-class-pk-0="pk_level == 0" data-class-pk-1="pk_level == 1" data-class-pk-2="pk_level == 2" data-class-pk-3="pk_level == 3" data-class-pk-4="pk_level == 4" data-class-pk-5="pk_level == 5" data-class-pk-6="pk_level >= 6" data-style-font-size="text_px + 'px'">{{name_text}}</span>
		<!-- Class name and server name crossfade in place (legacy's sine-wave alpha blend
		     between the two, RenderSubjectTexts()) -- two stacked spans, opacity-driven. -->
		<span class="counter-scaled" id="classname"  data-style-font-size="text_px + 'px'">{{classname_text}}</span>
		<span class="counter-scaled" id="servername" data-style-opacity="servername_opacity" data-style-font-size="text_px + 'px'">{{servername_text}}</span>

		<!-- Summary backdrop: the original's 8-piece frame (RenderFrame()) -- translucent fill, 4
		     corner sprites, 1px-wide edge sprites stretched across each edge, and the separator
		     under the level line, in the original's paint order. A bordered/backgrounded leaf with child elements can render an
		     incomplete box in this RmlUi build, so every piece is its own childless sibling. -->
		<div class="summary-fill"></div>
		<div class="summary-corner corner-tl"></div>
		<div class="summary-corner corner-tr"></div>
		<div class="summary-corner corner-bl"></div>
		<div class="summary-corner corner-br"></div>
		<div class="summary-edge edge-top"></div>
		<div class="summary-edge edge-bottom"></div>
		<div class="summary-edge edge-separator"></div>
		<div class="summary-edge edge-left"></div>
		<div class="summary-edge edge-right"></div>
		<span class="level-text counter-scaled" data-style-font-size="text_px + 'px'">Nivel: {{level_value}}</span>
		<div class="paris-points-box"></div>
        <span class="levelup-point-text counter-scaled native-fit" data-style-font-size="text_px + 'px'">Puntos: {{points_value}}</span>
		<span class="exp-text counter-scaled" data-style-font-size="text_px + 'px'">{{exp_text}}</span>
		<span class="point-probability-text counter-scaled" data-style-font-size="text_px + 'px'">{{point_probability_text}}</span>
		<span class="point-text counter-scaled" data-style-font-size="text_px + 'px'">{{point_text}}</span>

		<!-- STR row -->
		<div class="attr-textbox attr-textbox-str"><div class="paris-attribute-label-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div><div class="paris-attribute-value-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div></div>
		<span class="attr-label attr-label-str counter-scaled" data-class-attr-potion="str_value_source == 'potion'" data-class-attr-boosted="str_value_source == 'boosted'" data-style-font-size="text_px + 'px'">Fuerza</span>
		<span class="attr-value attr-value-str counter-scaled" data-class-attr-potion="str_value_source == 'potion'" data-class-attr-boosted="str_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{str_value_text}}</span>
		<div class="attr-lines attr-lines-str counter-scaled" data-style-font-size="text_px + 'px'">
			<span data-for="line : str_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_str" class="stat-btn stat-btn-str" data-attr-aria-disabled="!can_level_up"
		     data-event-click="chainfo_increase_stat(0)"></div>

		<!-- AGI row -->
		<div class="attr-textbox attr-textbox-agi"><div class="paris-attribute-label-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div><div class="paris-attribute-value-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div></div>
		<span class="attr-label attr-label-agi counter-scaled" data-class-attr-potion="agi_value_source == 'potion'" data-class-attr-boosted="agi_value_source == 'boosted'" data-style-font-size="text_px + 'px'">Agilidad</span>
		<span class="attr-value attr-value-agi counter-scaled" data-class-attr-potion="agi_value_source == 'potion'" data-class-attr-boosted="agi_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{agi_value_text}}</span>
		<div class="attr-lines attr-lines-agi counter-scaled" data-style-font-size="text_px + 'px'">
			<span data-for="line : agi_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_agi" class="stat-btn stat-btn-agi" data-attr-aria-disabled="!can_level_up"
		     data-event-click="chainfo_increase_stat(1)"></div>

		<!-- VIT row -->
		<div class="attr-textbox attr-textbox-vit"><div class="paris-attribute-label-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div><div class="paris-attribute-value-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div></div>
		<span class="attr-label attr-label-vit counter-scaled" data-class-attr-potion="vit_value_source == 'potion'" data-class-attr-boosted="vit_value_source == 'boosted'" data-style-font-size="text_px + 'px'">Vitalidad</span>
		<span class="attr-value attr-value-vit counter-scaled" data-class-attr-potion="vit_value_source == 'potion'" data-class-attr-boosted="vit_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{vit_value_text}}</span>
		<div class="attr-lines attr-lines-vit counter-scaled" data-style-font-size="text_px + 'px'">
			<span data-for="line : vit_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_vit" class="stat-btn stat-btn-vit" data-attr-aria-disabled="!can_level_up"
		     data-event-click="chainfo_increase_stat(2)"></div>

		<!-- ENE row -->
		<div class="attr-textbox attr-textbox-ene"><div class="paris-attribute-label-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div><div class="paris-attribute-value-frame"><div class="stat-border-tl"></div><div class="stat-border-tr"></div><div class="stat-border-bl"></div><div class="stat-border-br"></div><div class="stat-border-top"></div><div class="stat-border-bottom"></div><div class="stat-border-left"></div><div class="stat-border-right"></div></div></div>
		<span class="attr-label attr-label-ene counter-scaled" data-class-attr-potion="ene_value_source == 'potion'" data-class-attr-boosted="ene_value_source == 'boosted'" data-style-font-size="text_px + 'px'">Energia</span>
		<span class="attr-value attr-value-ene counter-scaled" data-class-attr-potion="ene_value_source == 'potion'" data-class-attr-boosted="ene_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{ene_value_text}}</span>
		<div class="attr-lines attr-lines-ene counter-scaled" data-style-font-size="text_px + 'px'">
			<span data-for="line : ene_lines" data-class-boosted="line.source == 'boosted'" data-class-buffed="line.source == 'buffed'">{{line.text}}</span>
		</div>
		<div id="btn_stat_ene" class="stat-btn stat-btn-ene" data-attr-aria-disabled="!can_level_up"
		     data-event-click="chainfo_increase_stat(3)"></div>

		<!-- CMD row -- Dark Lord only. -->
		<div class="attr-textbox attr-textbox-cmd" data-class-hidden="!show_charisma"></div>
		<span class="attr-label attr-label-cmd counter-scaled" data-class-hidden="!show_charisma" data-class-attr-potion="cmd_value_source == 'potion'" data-class-attr-boosted="cmd_value_source == 'boosted'" data-style-font-size="text_px + 'px'">Comando</span>
		<span class="attr-value attr-value-cmd counter-scaled" data-class-hidden="!show_charisma" data-class-attr-potion="cmd_value_source == 'potion'" data-class-attr-boosted="cmd_value_source == 'boosted'" data-style-font-size="text_px + 'px'">{{cmd_value_text}}</span>
		<div id="btn_stat_cmd" class="stat-btn stat-btn-cmd" data-class-hidden="!show_charisma" data-attr-aria-disabled="!can_level_up"
		     data-event-click="chainfo_increase_stat(4)"></div>

		<!-- Bottom action row: shared close button plus Quest/Pet/Master-Level shortcuts. -->
		<div id="btn_exit" class="info-btn info-btn-exit" data-event-click="window_close" data-attr-data-hint="exit_tooltip">
			<span class="btn-exit-label">×</span>
		</div>
		<div id="btn_quest" class="info-btn info-btn-quest" data-event-click="chainfo_click_quest" data-attr-data-hint="quest_tooltip"></div>
		<div id="btn_pet" class="info-btn info-btn-pet" data-event-click="chainfo_click_pet" data-attr-data-hint="pet_tooltip"></div>
		<div id="btn_visual_options" class="info-btn info-btn-masterlevel"
		     data-event-click="chainfo_click_visual_options" data-attr-data-hint="visual_options_tooltip"><span class="visual-options-glyph">&#9881;</span></div>
		<div id="frame_corner_close" data-event-click="window_close"></div>

        <div class="allocation-panel" data-if="allocation_open" data-class-percent="allocation_percent">
            <div class="allocation-close" data-event-click="allocation_close"></div>
            <div class="allocation-title counter-scaled" data-style-font-size="text_px + 'px'">REPARTIR PUNTOS</div>
            <div class="allocation-available"><div class="allocation-art art-available"><div class="allocation-art-fill"></div><div class="allocation-art-tl"></div><div class="allocation-art-tr"></div><div class="allocation-art-bl"></div><div class="allocation-art-br"></div><div class="allocation-art-top"></div><div class="allocation-art-bottom"></div><div class="allocation-art-left"></div><div class="allocation-art-right"></div></div><span class="allocation-caption counter-scaled" data-style-font-size="text_px + 'px'">Puntos disponibles: <strong>{{allocation_available}}</strong></span></div>
            <div class="allocation-rows">
                <div class="allocation-row" data-for="row : allocation_rows" data-class-disabled="!row.enabled">
                    <span class="allocation-label counter-scaled" data-style-font-size="text_px + 'px'">{{row.name}}</span>
                    <div class="allocation-input-art"><div class="allocation-art art-input"><div class="allocation-art-fill"></div><div class="allocation-art-tl"></div><div class="allocation-art-tr"></div><div class="allocation-art-bl"></div><div class="allocation-art-br"></div><div class="allocation-art-top"></div><div class="allocation-art-bottom"></div><div class="allocation-art-left"></div><div class="allocation-art-right"></div></div></div><span class="allocation-dark-lord counter-scaled" data-style-font-size="text_px + 'px'" data-if="!row.enabled">Solo DL</span><input class="allocation-input counter-scaled" data-style-font-size="text_px + 'px'" data-if="row.enabled" type="text" maxlength="5" data-value="row.amount" data-attrif-disabled="!row.enabled || allocation_busy || allocation_auto"/>
                    <span class="allocation-percent-label counter-scaled" data-style-font-size="text_px + 'px'" data-if="allocation_percent">%</span>
                    <div class="allocation-full" data-if="!allocation_percent" data-event-click="allocation_full(row.index)"><div class="allocation-checkbox" data-class-checked="row.full"><span data-if="row.full">✓</span></div><span class="allocation-full-label counter-scaled" data-style-font-size="text_px + 'px'">Lleno</span></div>
                </div>
            </div>
            <div class="allocation-mode allocation-amounts" data-class-selected="!allocation_percent" data-event-click="allocation_mode(false)"><div class="allocation-art art-tab"><div class="allocation-art-fill"></div><div class="allocation-art-tl"></div><div class="allocation-art-tr"></div><div class="allocation-art-bl"></div><div class="allocation-art-br"></div><div class="allocation-art-top"></div><div class="allocation-art-bottom"></div><div class="allocation-art-left"></div><div class="allocation-art-right"></div></div><span class="allocation-caption counter-scaled" data-style-font-size="text_px + 'px'">Cantidades</span></div>
            <div class="allocation-mode allocation-percent" data-class-selected="allocation_percent" data-event-click="allocation_mode(true)"><div class="allocation-art art-tab"><div class="allocation-art-fill"></div><div class="allocation-art-tl"></div><div class="allocation-art-tr"></div><div class="allocation-art-bl"></div><div class="allocation-art-br"></div><div class="allocation-art-top"></div><div class="allocation-art-bottom"></div><div class="allocation-art-left"></div><div class="allocation-art-right"></div></div><span class="allocation-caption counter-scaled" data-style-font-size="text_px + 'px'">Porcentajes</span></div>
            <div class="allocation-automatic" data-event-click="allocation_automatic"><div class="allocation-checkbox" data-class-checked="allocation_auto"><span data-if="allocation_auto">✓</span></div><span class="allocation-auto-label counter-scaled" data-style-font-size="text_px + 'px'">Añadir automaticamente</span></div>
            <div class="allocation-status counter-scaled" data-style-font-size="text_px + 'px'">{{allocation_status}}</div>
            <div class="allocation-button allocation-apply" data-event-click="allocation_apply"><div class="allocation-art art-assign"><div class="allocation-art-fill"></div><div class="allocation-art-tl"></div><div class="allocation-art-tr"></div><div class="allocation-art-bl"></div><div class="allocation-art-br"></div><div class="allocation-art-top"></div><div class="allocation-art-bottom"></div><div class="allocation-art-left"></div><div class="allocation-art-right"></div></div><span class="allocation-caption counter-scaled" data-style-font-size="text_px + 'px'">ASIGNAR</span></div>
            <div class="allocation-button allocation-cancel" data-event-click="allocation_close"><div class="allocation-art art-close"><div class="allocation-art-fill"></div><div class="allocation-art-tl"></div><div class="allocation-art-tr"></div><div class="allocation-art-bl"></div><div class="allocation-art-br"></div><div class="allocation-art-top"></div><div class="allocation-art-bottom"></div><div class="allocation-art-left"></div><div class="allocation-art-right"></div></div><span class="allocation-caption counter-scaled" data-style-font-size="text_px + 'px'" data-if="allocation_busy">DETENER</span><span class="allocation-caption counter-scaled" data-style-font-size="text_px + 'px'" data-if="!allocation_busy">CERRAR</span></div>
        </div>
	</div>
</body>
</rml>
