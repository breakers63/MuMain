/* Compact button pairs anchored to the lower corners; the scene remains visible between them. */
#panel { position:absolute; left:0; top:0; width:100%; height:100%; pointer-events:none; }
.btn-icon { position:absolute; width:70rem; height:24rem; line-height:24rem; bottom:22rem; text-align:center; cursor:pointer; pointer-events:auto; }
#btn_create { left:22rem; }
#btn_menu { left:98rem; }
#btn_connect { right:98rem; }
#btn_delete { right:22rem; }
.btn-icon-label { display:block; width:100%; height:100%; line-height:24rem; text-align:center; font-family:"token(font-login-display)"; font-size:11rem; color:#e9c77e; pointer-events:none; }
.btn-icon:hover .btn-icon-label { color:#fff0bd; }
#btn_connect .btn-icon-label { color:#ffe8aa; }
.btn-icon.disabled { pointer-events:none; cursor:default; opacity:0.45; }
.btn-icon-caption, .deco, .info-bar { display:none; }
#account_block_message { position:absolute; left:0; right:0; top:330rem; pointer-events:none; }
.line-row { line-height:18rem; text-align:center; }
.line { display:inline-block; color:#000000; background-color:rgba(255,255,0,128); white-space:nowrap; padding:0 2rem; }
