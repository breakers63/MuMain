@spritesheet ranking-background { src: "../../../Paris_RankingReferenceV5.tga"; ranking-background: 0px 0px 1024px 1024px; }
@spritesheet ranking-guild { src: "../../../Paris_GuildRankingV14.tga"; ranking-guild: 0px 0px 1024px 1024px; }
@spritesheet ranking-buttons { src: "../../../Paris_RankingColorsV14.tga"; ranking-red: 0px 0px 200px 56px; ranking-gold: 0px 64px 200px 56px; ranking-green: 0px 128px 200px 56px; }
@spritesheet ranking-coins { src: "../../../../Custom/Interface/BattlePass/zen_coins.tga"; ranking-coins: 0px 0px 140px 140px; }
#panel.paris-ranking { position:absolute;left:50%;top:0;margin-left:-280dp;width:560dp;height:418.1333dp;pointer-events:auto;color:#f3eddb;font-family:"token(font-body)";font-size:7dp;background-color:#080b0b; }
.ranking-background {position:absolute;width:100%;height:100%;decorator:image(ranking-background);}
.guilds .ranking-background {decorator:image(ranking-guild);}
.ranking-main,.ranking-profile,.ranking-guild,.ranking-missions {position:absolute;left:0;top:0;width:100%;height:100%;pointer-events:none;}
.ranking-main *,.ranking-missions * {pointer-events:auto;}
.ranking-tab,.ranking-prev,.ranking-next,.ranking-member-pager>span {cursor:pointer;text-align:center;color:#e7cb80;}
.ranking-tab {font-weight:bold;line-height:19.4dp;}
.tab-reset,.ranking-prev {decorator:image(ranking-red);} .tab-guild {decorator:image(ranking-gold);} .tab-mission,.ranking-next {decorator:image(ranking-green);}
.ranking-tab.active {border-bottom:1px #eed145;}
.ranking-close {border:1px #7e672b;background-color:#0c0e0d;text-align:center;line-height:15dp;color:#d9bc68;cursor:pointer;}
.ranking-search,.mission-search {padding:0;border:0;background-color:transparent;color:white;font-size:7dp;}
.ranking-placeholder,.mission-search-placeholder {pointer-events:none;}
.ranking-rows {overflow:hidden;}
.ranking-row {display:block;position:relative;height:12%;border-bottom:1px #9a792b;cursor:pointer;}
.ranking-row.selected {background-color:#45320d66;border:1px #b99a45;}
.ranking-position,.ranking-row-name,.ranking-value {position:absolute;top:0;height:100%;line-height:24dp;}
.ranking-position {left:3%;width:12%;text-align:center;} .ranking-row-name {left:17%;width:63%;} .ranking-value {right:3%;width:16%;text-align:center;}
.ranking-prev,.ranking-next,.ranking-page {line-height:19dp;font-size:6dp;text-align:center;}
.ranking-list-head {color:#ead084;} .ranking-list-head>span:first-child {position:absolute;left:0;} .ranking-list-head>span:last-child {position:absolute;right:0;}
.ranking-profile-name,.ranking-guild-name,.ranking-member-title {color:#e8cb75;font-size:12dp;font-weight:bold;}
.ranking-visibility {color:#b5e3c5;border:1px #357b4d;padding:3dp 4dp;font-size:6dp;}
#ranking-character {pointer-events:none;}
.ranking-character-label {text-align:center;color:#e7c776;font-size:6dp;}
.ranking-equipment-card {position:absolute;width:49.5%;height:15.5%;}
.ranking-item {position:absolute;left:4%;top:17%;width:17%;height:62%;pointer-events:none;}
.ranking-item-label {position:absolute;left:25%;top:7%;width:72%;font-weight:bold;font-size:6.2dp;}
.ranking-item-name {position:absolute;left:25%;top:33%;width:72%;height:65%;font-size:6.7dp;overflow:hidden;}
.ranking-stats>div {display:inline-block;width:24.5%;height:100%;padding-left:4dp;box-sizing:border-box;border-right:1px #b8993b;}
.ranking-stats strong,.ranking-member-stats,.mission-detail strong {color:#e3c569;}
.ranking-privacy {border:1px #8d7531;background-color:#111410;line-height:14dp;font-size:6dp;cursor:pointer;}
.ranking-privacy>span {position:absolute;left:5%;} .ranking-privacy .privacy-state {left:55%;font-size:5.5dp;}
.ranking-guild-mark {display:flex;flex-wrap:wrap;background-color:black;}
.ranking-guild-mark span {display:block;width:12.5%;height:12.5%;}
.ranking-guild-metrics>span {display:inline-block;width:32%;height:100%;line-height:18dp;text-align:center;color:#ebcf7d;}
.ranking-member {display:block;position:relative;height:16.6667%;cursor:pointer;}
.ranking-member:hover {background-color:#6b531b55;}
.ranking-portrait {position:absolute;left:2%;top:6%;width:14%;height:80%;border:1px #ae8a33;background-color:#090b09;}
.ranking-member-name {position:absolute;left:19%;top:18%;color:#e9cc80;font-weight:bold;}
.ranking-member-class {position:absolute;left:19%;top:56%;}
.ranking-members-count {text-align:right;color:#d6c278;}
.ranking-member-pager>span {display:inline-block;width:32%;height:100%;line-height:20dp;text-align:center;cursor:pointer;}
.ranking-member-pager>span:first-child {decorator:image(ranking-red);} .ranking-member-pager>span:last-child {decorator:image(ranking-green);}
.ranking-member-stats span,.ranking-member-attributes span,.ranking-member-details span {position:absolute;right:0;}
.ranking-member-attributes div {display:block;position:relative;height:10dp;}
.ranking-member-details div {position:relative;display:block;height:11dp;}
.ranking-member-online {color:#ebd180;}
.mission-list-heading {color:#e6c979;font-size:9dp;background-color:#090d0e;}
.mission-search {border:1px #8c6b21;background-color:#080a09;padding:0 4dp;}
.mission-list {overflow:hidden auto;background-color:#080d0e;}
.mission-row {display:block;position:relative;width:96%;height:43dp;margin-bottom:10dp;border:1px #8b6e27;background-color:#0b1012;cursor:pointer;}
.mission-row.selected {border-color:#e8cc47;background-color:#3a2d0f;}
.mission-rank {position:absolute;left:3%;top:34%;width:12%;color:#edd084;}
.mission-monster-small {position:absolute;left:16%;top:6%;width:17%;height:88%;}
.mission-name {position:absolute;left:34%;top:12%;width:41%;font-weight:bold;height:35%;overflow:hidden;}
.mission-objective {position:absolute;left:34%;top:60%;width:41%;height:35%;overflow:hidden;font-size:6.5dp;}
.mission-reward-icon {position:absolute;left:72%;top:15%;width:8%;height:45%;decorator:image(ranking-coins);}
.mission-reward-count {position:absolute;left:82%;top:20%;} .mission-reward-name {position:absolute;left:77%;top:65%;font-size:6dp;}
.mission-detail {background-color:#070b0c;border:1px #9b7b31;}
.mission-title {position:absolute;left:3%;top:3%;font-size:15dp;font-weight:bold;color:#ead184;}
.mission-monster-large {position:absolute;left:3%;top:13%;width:27%;height:23%;border:1px #a0842d;}
.mission-objective-box,.mission-reward-box {position:absolute;left:33%;width:64%;height:11%;line-height:17dp;border-bottom:1px #a0842d;font-size:9dp;}
.mission-objective-box {top:13%;} .mission-reward-box {top:25%;}
.mission-detail strong {font-size:8dp;}
.mission-progress-box {position:absolute;left:3%;top:39%;width:94%;height:12%;border:1px #9b7b31;padding:3dp;box-sizing:border-box;}
.mission-progress-box>span {position:absolute;right:3%;top:3dp;}
.mission-progress-track {position:absolute;left:2%;top:52%;width:96%;height:30%;border:1px #a0842d;background-color:#020303;}
.mission-progress-track div {display:block;height:100%;background-color:#08a12b;}
.mission-ranking-title {position:absolute;left:4%;top:56%;color:#e7ca6d;font-size:9dp;}
.mission-ranking-head {position:absolute;left:4%;top:63%;width:92%;height:7%;color:#e7ca6d;}
.mission-ranking-head span,.mission-ranking-row span {display:inline-block;width:30%;text-align:center;}
