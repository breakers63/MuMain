portrait-2: 512px 0px 256px 256px;
portrait-3: 0px 256px 256px 256px;
portrait-4: 256px 256px 256px 256px;
portrait-5: 512px 256px 256px 256px;
}

@spritesheet ranking-extra-portraits { src: ../paris-gold/Paris_ClassPortraitsV13.jpg; class-3: 1.5px 259.5px 250px 250px; class-4: 259.5px 259.5px 250px 250px; class-5: 517.5px 259.5px 250px 250px; }
.ranking-portrait.class-0 { decorator:image(portrait-0); }
.ranking-portrait.class-1 { decorator:image(portrait-1); }
.ranking-portrait.class-2 { decorator:image(portrait-2); }
.ranking-portrait.class-3 { decorator:image(portrait-3); }
.ranking-portrait.class-4 { decorator:image(portrait-4); }
.ranking-portrait.class-5 { decorator:image(portrait-5); }

