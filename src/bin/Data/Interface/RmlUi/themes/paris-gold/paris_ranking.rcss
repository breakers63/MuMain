@spritesheet ranking-scroll {src: "../paris-gold/bank-scroll.tga"; rank-scroll-track:0px 0px 42px 230px; rank-scroll-thumb:48px 0px 67px 120px; rank-scroll-up:48px 128px 46px 48px; rank-scroll-down:48px 180px 46px 49px;}
.mission-list scrollbarvertical {width:12dp;margin:0;}
.mission-list scrollbarvertical slidertrack {margin-left:4dp;margin-right:4dp;decorator:image(rank-scroll-track);}
.mission-list scrollbarvertical sliderbar {width:12dp;height:20dp;decorator:image(rank-scroll-thumb);}
.mission-list scrollbarvertical sliderarrowdec,.mission-list scrollbarvertical sliderarrowinc {width:10dp;height:10dp;cursor:pointer;}
.mission-list scrollbarvertical sliderarrowdec {decorator:image(rank-scroll-up);}
.mission-list scrollbarvertical sliderarrowinc {decorator:image(rank-scroll-down);}
.mission-list scrollbarhorizontal {height:0;}

/* Full-panel composition layers must never intercept tabs or the player list. */
.ranking-main .ranking-profile, .ranking-main .ranking-guild, .ranking-mission-back, .ranking-background { pointer-events: none; }
.ranking-main .ranking-equipment-card, .ranking-main .ranking-member, .ranking-main .ranking-member-pager > span { pointer-events: auto; }

/* Keep labels inside the artwork's cells, with explicit line boxes. */
.ranking-item-label { top: 8%; height: 23%; line-height: 8dp; }
.ranking-item-name { top: 36%; height: 57%; line-height: 8dp; font-size: 6.4dp; }
.ranking-profile-name, .ranking-guild-name { line-height: 16dp; }
.ranking-profile-class, .ranking-guild-master { line-height: 10dp; }
.ranking-character-label { line-height: 12dp; }
.ranking-stats > div { font-size: 6.5dp; line-height: 8dp; padding-top: 2dp; }
