.ranking-visibility {box-sizing:border-box;line-height:16dp;text-align:center;height:4%;padding:0;}
@spritesheet ranking-class-art {src: "../paris-gold/Paris_ClassPortraitsV13.jpg";
 rank-class-0: 259.5px 1.5px 250px 250px;
 rank-class-1: 1.5px 1.5px 250px 250px;
 rank-class-2: 517.5px 1.5px 250px 250px;
 rank-class-3: 1.5px 259.5px 250px 250px;
 rank-class-4: 259.5px 259.5px 250px 250px;
 rank-class-5: 517.5px 259.5px 250px 250px;
}
.ranking-portrait.class-0 {decorator:image(rank-class-0);}
.ranking-portrait.class-1 {decorator:image(rank-class-1);}
