/* Approved event panel: uniformly reduced to 90 percent. */
/* RmlUi layout: each repeated row has an explicit block width; no browser defaults. */
#panel.paris-event-guide {position:absolute;left:50%;top:1%;margin-left:-270dp;width:540dp;height:372.6dp;box-sizing:border-box;background-color:#0c0d0b;border:1.8dp #ba8c25;pointer-events:auto;color:#ede3c8;font-family:"token(font-body)";font-size:7.2dp;}
.paris-event-guide div,.paris-event-guide p,.paris-event-guide h3 {display:block;box-sizing:border-box;}
.paris-event-guide * {font-family:"token(font-body)";}
.paris-event-guide button {display:block;box-sizing:border-box;color:#ead099;background-color:#18150e;border:0.9dp #8e7036;cursor:pointer;padding:0;font-size:7.2dp;}
.paris-event-guide button:disabled {opacity:0.45;cursor:default;}
.paris-event-guide button:hover {border-color:#ffe5a3;background-color:#3a2c17;}
.paris-event-guide button.selected {border-color:#ffe5a3;background-color:#433013;}
.paris-event-guide .live {color:#9cde75;}.paris-event-guide .unmet {color:#ef917b;}
.paris-event-guide h3 {margin:0;padding:0;color:#efd18d;font-size:8.1dp;font-weight:bold;}
.paris-event-guide p {margin:0;}
.guide-header {position:absolute;left:12.6dp;top:4.5dp;width:511.2dp;height:42.3dp;border-bottom:0.9dp #b38a3e;text-align:center;cursor:move;}
.guide-brand {position:absolute;left:135dp;top:3.6dp;width:241.2dp;height:9dp;color:#e6c97e;font-size:6.3dp;letter-spacing:1.8dp;text-align:center;}
.guide-heading {position:absolute;left:135dp;top:12.6dp;width:241.2dp;height:27dp;line-height:27dp;font-size:22.5dp;font-weight:bold;color:#ffe4a0;text-align:center;}
.paris-event-guide .guide-x {position:absolute;right:12.6dp;top:9dp;width:20.7dp;height:22.5dp;line-height:20.7dp;text-align:center;color:#ffdb78;background-color:#35170d;z-index:5;}
.guide-categories {position:absolute;left:14.4dp;top:50.4dp;width:509.4dp;height:18.9dp;}
.guide-categories button {position:absolute;top:0;width:81.9dp;height:18dp;line-height:16.2dp;text-align:center;}
.guide-categories button:nth-child(1) {left:0;}.guide-categories button:nth-child(2) {left:85.5dp;}.guide-categories button:nth-child(3) {left:171dp;}.guide-categories button:nth-child(4) {left:256.5dp;}.guide-categories button:nth-child(5) {left:342dp;}.guide-categories button:nth-child(6) {left:427.5dp;}
.guide-sidebar {position:absolute;left:14.4dp;top:75.6dp;width:158.4dp;height:275.4dp;border:0.9dp #b18b41;background-color:#090a08;}
.guide-list-title {position:absolute;left:4.5dp;top:3.6dp;width:147.6dp;height:17.1dp;line-height:14.4dp;font-size:8.1dp;font-weight:bold;color:#f3d18a;border-bottom:0.9dp #866a31;}
.guide-list-title span {position:absolute;right:1.8dp;top:0;}
.guide-events {position:absolute;left:4.5dp;top:23.4dp;width:147.6dp;height:227.7dp;overflow:hidden;}
.paris-event-guide .guide-event {position:relative;display:block;width:147.6dp;height:23.4dp;margin:0 0 1.8dp 0;text-align:left;}
.guide-event span {display:block;position:absolute;left:4.5dp;top:2.7dp;width:86.4dp;height:18dp;line-height:9dp;font-size:7.2dp;white-space:normal;overflow:hidden;}
.guide-event strong {display:block;position:absolute;left:92.7dp;top:6.3dp;width:48.6dp;height:10.8dp;line-height:10.8dp;font-size:6.3dp;font-weight:normal;color:#f0cb61;text-align:right;white-space:nowrap;}
.guide-events p {width:142.2dp;font-size:7.2dp;padding:10.8dp 2.7dp;}
.guide-paging {position:absolute;left:4.5dp;bottom:3.6dp;width:147.6dp;height:16.2dp;text-align:center;}
.guide-paging button {position:absolute;top:0;width:24.3dp;height:16.2dp;line-height:14.4dp;text-align:center;}
.guide-paging button:first-child {left:0;}.guide-paging button:last-child {right:0;}
.guide-paging>span {display:block;position:absolute;left:27dp;top:0;width:93.6dp;height:16.2dp;line-height:16.2dp;text-align:center;}
.guide-detail {position:absolute;left:180dp;top:75.6dp;width:343.8dp;height:275.4dp;}
.guide-content {position:absolute;left:0;top:0;width:343.8dp;height:275.4dp;}
.guide-detail-title {position:absolute;left:0;top:0;width:343.8dp;height:22.5dp;border:0.9dp #af8d43;background-color:#1d1a10;}
.guide-detail-title h3 {position:absolute;left:4.5dp;top:3.6dp;width:209.7dp;height:16.2dp;line-height:16.2dp;font-size:10.8dp;white-space:nowrap;overflow:hidden;}
.guide-detail-title>span {display:block;position:absolute;right:4.5dp;top:6.3dp;width:117dp;height:10.8dp;line-height:10.8dp;color:#9cde75;text-align:right;font-size:6.3dp;}
.guide-banner {position:absolute;left:0;top:25.2dp;width:343.8dp;height:70.2dp;border:0.9dp #af8d43;background-color:#101b24;}
#guide-boss-model {position:absolute;left:55.8dp;top:0;width:230.4dp;height:57.6dp;}
.guide-boss-caption {position:absolute;left:0;bottom:0;width:342dp;height:12.6dp;line-height:12.6dp;text-align:center;background-color:#10110d;color:#edce84;font-size:8.1dp;font-weight:bold;}
.guide-metrics {position:absolute;left:0;top:98.1dp;width:343.8dp;height:25.2dp;border:0.9dp #af8d43;background-color:#11130f;}
.guide-metrics>div {position:absolute;top:0;width:171dp;height:23.4dp;text-align:center;}
.guide-metrics>div:first-child {left:0;border-right:0.9dp #6b542b;}.guide-metrics>div:last-child {right:0;}
.guide-metrics span,.guide-metrics strong {display:block;position:absolute;left:0;width:169.2dp;text-align:center;}
.guide-metrics span {top:1.8dp;height:8.1dp;font-size:6.3dp;color:#d9c798;}.guide-metrics strong {top:9.9dp;height:12.6dp;font-size:9dp;color:#f5d57e;}
.guide-info {position:absolute;left:0;top:126.9dp;width:343.8dp;height:101.7dp;}
.guide-requirements {position:absolute;left:0;top:0;width:196.2dp;height:101.7dp;border:0.9dp #a68541;background-color:#10110d;}
.guide-requirements h3,.guide-monsters h3 {position:absolute;left:0;top:0;width:194.4dp;height:16.2dp;line-height:16.2dp;border-bottom:0.9dp #8c713b;text-align:center;font-size:7.2dp;}
.guide-scroll {position:absolute;left:3.6dp;top:18dp;width:187.2dp;height:81dp;overflow-y:auto;overflow-x:hidden;}
.guide-requirement {position:relative;display:block;width:178.2dp;height:22.5dp;border-bottom:0.9dp #393527;margin:0 0 1.8dp 0;}
.guide-requirement span,.guide-requirement strong {display:block;position:absolute;top:1.8dp;height:19.8dp;line-height:9dp;font-size:6.75dp;white-space:normal;overflow:hidden;}
.guide-requirement span {left:0;width:71.1dp;color:#e2d6bb;}.guide-requirement strong {left:74.7dp;width:101.7dp;text-align:right;font-weight:normal;}
.guide-monsters {position:absolute;left:199.8dp;top:0;width:144dp;height:101.7dp;border:0.9dp #a68541;background-color:#0e1110;}
.guide-monsters h3 {width:142.2dp;font-size:6.75dp;}
.guide-monster-cards {position:absolute;left:2.7dp;top:18.9dp;width:136.8dp;height:60.3dp;}
.guide-monster {position:absolute;top:0;width:44.1dp;height:60.3dp;border:0.9dp #695535;text-align:center;}
.guide-monster:nth-child(1) {left:0;}.guide-monster:nth-child(2) {left:45.9dp;}.guide-monster:nth-child(3) {left:91.8dp;}
.guide-monster-model {position:absolute;left:0.9dp;top:0;width:40.5dp;height:45dp;}
.guide-monster>span {display:block;position:absolute;left:0.9dp;top:44.1dp;width:40.5dp;height:14.4dp;line-height:7.2dp;font-size:5.85dp;overflow:hidden;}
.guide-monsters .guide-paging {left:2.7dp;bottom:2.7dp;width:136.8dp;height:14.4dp;}.guide-monsters .guide-paging button {height:14.4dp;line-height:12.6dp;}.guide-monsters .guide-paging>span {left:25.2dp;width:86.4dp;height:14.4dp;line-height:14.4dp;}
.guide-footer {position:absolute;left:0;top:232.2dp;width:343.8dp;height:43.2dp;border:0.9dp #a68541;background-color:#0e100c;}
.guide-rewards {position:absolute;left:3.6dp;top:2.7dp;width:200.7dp;height:36.9dp;}
.guide-rewards h3 {height:10.8dp;line-height:10.8dp;font-size:7.2dp;}
.guide-reward-scroll {position:absolute;left:0;top:11.7dp;width:198dp;height:24.3dp;overflow-y:auto;overflow-x:hidden;font-size:6.3dp;}
.guide-rewards p {display:block;width:184.5dp;line-height:9dp;margin:0 0 2.7dp 0;}
.guide-actions {position:absolute;right:3.6dp;top:3.6dp;width:129.6dp;height:36dp;}
.guide-actions button {position:absolute;left:0;top:18.9dp;width:129.6dp;height:16.2dp;line-height:14.4dp;text-align:center;font-size:7.2dp;}
.guide-actions .guide-enter {top:0;height:18dp;line-height:16.2dp;background-color:#4c3714;color:#ffe4a1;font-weight:bold;}
.guide-wait {position:absolute;left:22.5dp;top:81dp;width:297dp;height:72dp;line-height:12.6dp;text-align:center;color:#d4c08f;}
.guide-status {position:absolute;left:14.4dp;top:355.5dp;width:509.4dp;height:10.8dp;line-height:10.8dp;text-align:center;color:#bba879;font-size:6.3dp;}
.guide-corner,.guide-dragon {position:absolute;pointer-events:none;}
.guide-corner {width:18dp;height:30.6dp;z-index:4;}.guide-corner.tl {left:-1.8dp;top:-1.8dp;}.guide-corner.tr {right:-1.8dp;top:-1.8dp;}.guide-corner.bl {left:-1.8dp;bottom:-1.8dp;}.guide-corner.br {right:-1.8dp;bottom:-1.8dp;}
.guide-dragon {top:0;width:52.2dp;height:38.7dp;}.guide-dragon.left {left:68.4dp;}.guide-dragon.right {right:68.4dp;}

@spritesheet guide-frame-corners {src:"paris-frame.tga";guide-tl:0px 20px 50px 86px;guide-bl:0px 938px 50px 86px;guide-stone:60px 160px 128px 128px;}
@spritesheet guide-dragon-head {src:"../../../Paris_HudDragons37.tga";guide-dragon-left:8px 28px 154px 110px;guide-dragon-right:1886px 28px 154px 110px;}
.guide-corner.tl {decorator:image(guide-tl contain);}.guide-corner.tr {decorator:image(guide-tl flip-horizontal contain);}
.guide-corner.bl {decorator:image(guide-bl contain);}.guide-corner.br {decorator:image(guide-bl flip-horizontal contain);}
.guide-dragon.left {decorator:image(guide-dragon-left contain);}.guide-dragon.right {decorator:image(guide-dragon-right contain);}



