.guide-rewards h3 {height:9dp;line-height:9dp;font-size:7.65dp;}
.guide-reward-scroll {top:9.9dp;height:18.9dp;overflow-y:auto;overflow-x:hidden;}
.guide-rewards p {height:auto;margin:0 0 0.9dp 0;line-height:7.65dp;white-space:normal;word-break:break-word;}
.guide-requirement-column scrollbarvertical,.guide-reward-scroll scrollbarvertical {width:3.6dp;}
