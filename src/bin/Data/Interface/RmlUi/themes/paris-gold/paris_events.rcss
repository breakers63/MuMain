/* Live requirement values wrap in normal flow, without per-row clipping. */
.guide-scroll {top:18.9dp;height:88.2dp;}
.guide-requirement-column {height:88.2dp;}
.paris-event-guide .guide-requirement,
.guide-scroll.compact .guide-requirement {
    height:auto;min-height:0;margin:0 0 0.9dp 0;padding:0 0 0.9dp 0;
}
.guide-requirement span,.guide-requirement strong,
.guide-scroll.compact .guide-requirement span,
.guide-scroll.compact .guide-requirement strong {
    position:static;display:block;left:auto;top:auto;width:68.4dp;height:auto;
    margin:0 1.8dp;white-space:normal;word-break:break-word;overflow:visible;
}
.guide-requirement span,.guide-scroll.compact .guide-requirement span {
    font-size:5.76dp;line-height:6.3dp;
}
.guide-requirement strong,.guide-scroll.compact .guide-requirement strong {
    font-size:5.94dp;line-height:6.75dp;
}
