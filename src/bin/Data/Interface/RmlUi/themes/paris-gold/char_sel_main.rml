<rml>
<head>
	<title>Character Select Bar</title>
	<link type="text/rcss" href="base.rcss"/>
	<link type="text/rcss" href="char_sel_main.rcss"/>
	<link type="text/rcss" href="paris_subtle_button.rcss"/>
</head>
<body class="scene-bar-scale" data-model="char_sel_main">
	<!-- Compact Paris buttons retain the character-select actions and disabled states. -->
	<div id="panel">
		<div id="deco" class="deco anchor-bottom-right"></div>
		<div id="info_bar" class="info-bar stretch-x"></div>
		<div id="btn_create_item" class="btn-icon-item">
			<div id="btn_create" class="btn-icon paris-small-button" data-class-disabled="create_disabled" data-event-click="charsel_create_click"><span class="btn-icon-label">CREAR</span></div>
			<span class="btn-icon-caption">Create</span>
		</div>
		<div id="btn_menu_item" class="btn-icon-item">
			<div id="btn_menu" class="btn-icon btn-icon-primary paris-small-button" data-event-click="charsel_menu_click"><span class="btn-icon-label">MENÚ</span></div>
			<span class="btn-icon-caption">Menu</span>
		</div>
		<div id="btn_connect_item" class="btn-icon-item">
			<div id="btn_connect" class="btn-icon paris-small-button" data-class-disabled="connect_disabled" data-event-click="charsel_connect_click"><span class="btn-icon-label">ENTRAR</span></div>
			<span class="btn-icon-caption">Connect</span>
		</div>
		<div id="btn_delete_item" class="btn-icon-item">
			<div id="btn_delete" class="btn-icon paris-small-button" data-class-disabled="delete_disabled" data-event-click="charsel_delete_click"><span class="btn-icon-label">ELIMINAR</span></div>
			<span class="btn-icon-caption">Delete</span>
		</div>
	</div>
	<!-- Rarely shown (account has an item-blocked character); fixed, centered, independent of #panel. -->
	<div id="account_block_message" class="native-text" data-class-hidden="account_block_hidden">
		<div class="line-row"><span class="line">{{account_block_line1}}</span></div>
		<div class="line-row"><span class="line">{{account_block_line2}}</span></div>
	</div>
</body>
</rml>
