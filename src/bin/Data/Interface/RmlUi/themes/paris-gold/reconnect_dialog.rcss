/* Paris gold reconnect: retain the overlay geometry, progress and Cancel behavior. */
@spritesheet rc-paris-frame-sheet {
    src: "../../../ParisLogin/dialog-frame.tga";
    rc-paris-frame: 20px 180px 1540px 620px;
}
body { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; font-family: "token(font-body)"; }
#dim { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #000000; pointer-events: none; }
#panel { position: absolute; transform-origin: left top; width: 230px; height: 122px; pointer-events: none; }
#back { position: absolute; left: 0; top: 0; width: 230px; height: 122px; decorator: image(rc-paris-frame); }
#box_top, #box_middle, #box_bottom { display: none; }
#progress_back { position: absolute; left: 35px; top: 67px; width: 160px; height: 13px; background-color: #080808; border: 1px #b98a28; border-radius: 2px; }
#progress_bar { position: absolute; left: 40px; top: 71px; height: 6px; background-color: #e5b642; }
#cancel { position: absolute; left: 75px; top: 89px; width: 80px; height: 24px; pointer-events: auto; }
#rc_cancel_label { position: absolute; left: 0; top: 5px; width: calc(80px * var(--root-scale)); text-align: center; color: #f4dca0; pointer-events: none; }
.sharp-text { display: block; white-space: nowrap; pointer-events: none; transform-origin: left top; }
.line { position: absolute; left: 0; width: calc(230px * var(--root-scale)); text-align: center; color: #ffffff; }
#rc_title { top: 13px; font-weight: bold; color: #ffdc77; }
#rc_step { top: 33px; }
#rc_countdown { top: 50px; color: #e9c77e; }
