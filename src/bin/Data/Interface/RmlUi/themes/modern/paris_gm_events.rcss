/* Original GM artwork: cropped outer photographic border; fixed aspect above the HUD. */
@spritesheet gm-art { src: "../../../Paris_GmPanelV31.tga"; gm-panel:85px 0px 602.5px 470px; }
#panel.paris-gm-events { position:absolute;left:50%;top:0;margin-left:-260dp;width:520dp;height:405.64dp;decorator:image(gm-panel);pointer-events:auto;font-family:"token(font-body)";font-size:7dp;color:#f4ead5; }
.paris-gm-events div,.paris-gm-events span { box-sizing:border-box; }
.paris-gm-events input { position:absolute;background-color:transparent;border:0;color:white;font-size:7dp;padding:0; }
.paris-gm-events button { position:absolute;display:block;background-color:transparent;border:0;padding:0;cursor:pointer; }
.paris-gm-events button:hover,.gm-event:hover {background-color:#ffd96520;}
.paris-gm-events button:disabled {cursor:default;background-color:#00000048;}
.gm-events {position:absolute;overflow:hidden auto;}
.gm-event {display:block;position:relative;height:23.73dp;cursor:pointer;}
.gm-event.selected {background-color:#d5ad3730;}
.gm-event span {display:block;position:absolute;left:18%;top:0;width:80%;height:100%;line-height:23.73dp;font-size:7.3dp;}
.gm-event.selected span,.gm-name {color:#f4d486;font-weight:bold;}
.gm-placeholder {position:absolute;pointer-events:none;color:#ddd;}
.gm-name,.gm-phase,.gm-participants,.gm-countdown,.gm-duration,.gm-map,.gm-requirement,.gm-status,.gm-last {position:absolute;line-height:10dp;}
.gm-phase {color:#f8d883;text-align:center;font-size:6.5dp;}
.gm-participants,.gm-countdown,.gm-duration {color:#f8d883;font-weight:bold;text-align:center;}
.gm-close,.gm-exit,.gm-refresh {position:absolute;cursor:pointer;}
