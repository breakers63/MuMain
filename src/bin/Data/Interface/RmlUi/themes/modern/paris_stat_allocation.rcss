.allocation-dark-lord {position:absolute;left:72px;top:6px;width:55px;text-align:center;color:#aaa69a;font-size:7.75px;z-index:1;}
.allocation-row.disabled { color: #f5f5f5; }

/* Rasterise text at its final pixel size instead of magnifying small glyphs with the panel. */
.allocation-title { width:calc(166px * var(--root-scale, 1)); margin-left:calc(83px - 83px * var(--root-scale, 1)); transform-origin:center top; }
.allocation-label { width:calc(48px * var(--root-scale, 1)); margin-left:calc(24px - 24px * var(--root-scale, 1)); transform-origin:center top; font-weight:normal; color:#ffffff; }
.allocation-caption { position:absolute; left:0; top:0; width:calc(100% * var(--root-scale, 1)); margin-left:calc(50% - 50% * var(--root-scale, 1)); transform-origin:center top; line-height:calc(22px * var(--root-scale, 1)); white-space:nowrap; }
.allocation-available .allocation-caption { line-height:calc(20px * var(--root-scale, 1)); }
.allocation-button .allocation-caption { line-height:calc(24px * var(--root-scale, 1)); }
.allocation-input, .allocation-input:disabled { width:calc(55px * var(--root-scale, 1)); height:calc(22px * var(--root-scale, 1)); line-height:calc(22px * var(--root-scale, 1)); transform-origin:left top; color:#ffffff; opacity:1; font-weight:normal; }
.allocation-dark-lord { width:calc(55px * var(--root-scale, 1)); margin-left:calc(27.5px - 27.5px * var(--root-scale, 1)); transform-origin:center top; color:#ffffff; }
.allocation-full-label { width:calc(24px * var(--root-scale, 1)); transform-origin:left top; color:#ffffff; }
.allocation-percent-label { width:calc(20px * var(--root-scale, 1)); margin-left:calc(10px - 10px * var(--root-scale, 1)); transform-origin:center top; color:#ffffff; }
.allocation-auto-label { width:calc(110px * var(--root-scale, 1)); transform-origin:left top; color:#ffffff; }
.allocation-status { width:calc(166px * var(--root-scale, 1)); margin-left:calc(83px - 83px * var(--root-scale, 1)); transform-origin:center top; }

/* Repartir puntos sits beside its character sheet rather than covering it. */
.allocation-panel {left:-194px;}
