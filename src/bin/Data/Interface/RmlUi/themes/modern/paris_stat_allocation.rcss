/* The OpenGL allocation overlay occupies the same 190x429 reference box as Stats. */
@spritesheet allocation-frame-sheet { src: "../paris-gold/paris-frame.tga"; allocation-frame: 0px 0px 512px 1024px; }
@spritesheet allocation-controls-sheet { src: "../paris-gold/Paris_AllocationControls47.tga";
allocation-input: 0px 0px 272px 78px;
allocation-available: 0px 100px 561px 88px;
allocation-checkbox: 0px 220px 64px 63px;
allocation-tab: 0px 300px 391px 86px;
allocation-selected: 0px 420px 389px 86px;
allocation-assign: 0px 540px 378px 96px;
allocation-close: 0px 680px 376px 96px;
}
.allocation-panel { font-family: "token(font-body)"; position: absolute; left: 0; top: 0; width: 190px; height: 429px; decorator: image(allocation-frame); z-index: 20; pointer-events: auto; color: #f5f5f5; font-size: 7.75px; }
.allocation-close { position: absolute; right: 9px; top: 22px; width: 16px; height: 18px; cursor: pointer; z-index: 5; }
.allocation-title { position: absolute; left: 12px; top: 37px; width: 166px; text-align: center; color: #ffdd23; font-weight: bold; }
.allocation-available { position: absolute; left: 14px; top: 56px; width: 162px; height: 20px; line-height: 20px; text-align: center; decorator: image(allocation-available); }
.allocation-available strong { color: #ffdd23; }
.allocation-rows { position: absolute; left: 0; top: 112px; width: 190px; }
.allocation-row { display: block; position: relative; height: 38px; width: 190px; }
.allocation-label { position: absolute; left: 16px; top: 6px; text-align: center; width: 48px; }
.allocation-input { position: absolute; left: 72px; top: 0; width: 55px; height: 22px; padding: 0; line-height: 22px; background-color: transparent; border: 0; text-align: center; color: #ffffff; font-size: 7.75px; decorator: image(allocation-input); }
.allocation-row.disabled { color: #7a7565; }
.allocation-input:disabled { color: #7a7565; }
.allocation-percent-label { position: absolute; left: 136px; top: 5px; width: 20px; text-align: center; }
.allocation-full { position: absolute; left: 136px; top: 3px; height: 16px; width: 40px; cursor: pointer; }
.allocation-full > span { position: absolute; left: 15px; top: 3px; }
.allocation-checkbox { display: inline-block; position: relative; width: 12px; height: 12px; decorator: image(allocation-checkbox); }
.allocation-checkbox span { display: block; text-align: center; line-height: 12px; color: #ffdd23; font-size: 10px; }
.allocation-mode { position: absolute; top: 310px; width: 79px; height: 22px; line-height: 22px; text-align: center; cursor: pointer; decorator: image(allocation-tab); }
.allocation-mode.selected { decorator: image(allocation-selected); color: #ffdd23; }
.allocation-amounts { left: 12px; }.allocation-percent { left: 99px; }
.allocation-automatic { position: absolute; left: 14px; top: 343px; height: 18px; width: 157px; cursor: pointer; }
.allocation-automatic > span { position: absolute; left: 47px; top: 3px; }
.allocation-status { position: absolute; left: 12px; top: 365px; width: 166px; height: 16px; text-align: center; color: #ffdd23; font-size: 7.25px; }
.allocation-button { position: absolute; top: 384px; width: 79px; height: 24px; line-height: 24px; text-align: center; cursor: pointer; color: #ffe169; font-weight: bold; }
.allocation-apply { left: 12px; decorator: image(allocation-assign); }.allocation-cancel { left: 99px; decorator: image(allocation-close); }
.paris-points-box { pointer-events: auto; cursor: pointer; }

/* Only sample the empty interiors and ornate edges; atlas captions are replaced by live text. */
.allocation-available, .allocation-input, .allocation-mode, .allocation-mode.selected, .allocation-button { decorator: none; }
.allocation-input-art { position: absolute; left: 72px; top: 0; width: 55px; height: 22px; pointer-events: none; }
.allocation-caption { position: relative; z-index: 1; }
.allocation-input { z-index: 1; }
.allocation-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.allocation-art > div { position: absolute; pointer-events: none; }
.allocation-art-fill { left: 0; top: 0; width: 100%; height: 100%; }
.allocation-art-tl, .allocation-art-tr, .allocation-art-bl, .allocation-art-br { width: 4px; height: 4px; }
.allocation-art-tl { left: 0; top: 0; }.allocation-art-tr { right: 0; top: 0; }.allocation-art-bl { left: 0; bottom: 0; }.allocation-art-br { right: 0; bottom: 0; }
.allocation-art-top, .allocation-art-bottom { left: 4px; right: 4px; height: 2px; }
.allocation-art-top { top: 0; }.allocation-art-bottom { bottom: 0; }
.allocation-art-left, .allocation-art-right { top: 4px; bottom: 4px; width: 2px; }
.allocation-art-left { left: 0; }.allocation-art-right { right: 0; }
