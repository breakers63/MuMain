.emoji-label {width:8%;height:8%;margin-left:-4%;margin-top:-4%;}
#music-panel {position:absolute;right:10dp;top:20%;width:270dp;padding:12dp;background-color:#14120ff5;border:2dp #cba14c;color:#eee4c9;font-family:"token(font-body)";font-size:10dp;pointer-events:auto;}
#music-panel h2 {color:#f1cb68;font-size:14dp;margin-bottom:12dp;}
.music-song,.music-time,.music-status,.music-note {display:block;margin-bottom:10dp;}
.music-note {color:#b5ad96;font-size:8dp;}
.music-buttons {display:flex;flex-wrap:wrap;gap:6dp;margin-bottom:12dp;}
.music-buttons button {padding:6dp;background-color:#30291d;border:1dp #b28b42;color:#e9d99a;cursor:pointer;}
.music-buttons button.active {background-color:#66501d;}
