#gesture-overlay { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: auto; }
#wheel { position: absolute; left: 0; right: 0; top: 0; bottom: 0; width: 70vh; height: 70vh; max-width: 350dp; max-height: 350dp; margin: auto; color: #eee8d5; font-family: "token(font-body)"; font-size: 9dp; }
.wheel-art { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.gesture-label { position: absolute; width: 14%; height: 5%; margin-left: -7%; margin-top: -2.5%; text-align: center; pointer-events: none; }
.gesture-label.active { color: #ffcf62; font-weight: bold; }
.gesture-caption { position: absolute; left: 40%; top: 46%; width: 20%; height: 9%; text-align: center; color: #f2cc77; font-size: 8dp; pointer-events: none; }
.gesture-help { position: absolute; top: 101%; width: 100%; text-align: center; color: #e8d59e; font-size: 8dp; pointer-events: none; }
