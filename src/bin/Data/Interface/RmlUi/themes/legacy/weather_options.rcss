/* Added settings reuse the existing options window; original tabs are unchanged. */
.paris-weather-panel {display:block;position:relative;width:100%;color:token(text-primary);font-family:"token(font-body)";padding:4dp 0;}
.paris-weather-panel.hidden {display:none;}
.weather-section-title {display:block;text-align:center;color:token(text-heading);font-weight:bold;padding:8dp 2dp;}
.weather-setting-row {display:block;position:relative;min-height:28dp;width:100%;}
.weather-toggle {position:absolute;left:0;top:0;bottom:0;right:92dp;pointer-events:auto;cursor:pointer;}
.weather-checkbox {position:absolute;left:4dp;top:7dp;width:12dp;height:12dp;box-sizing:border-box;border:1dp #8f794b;background-color:#17130b;}
.weather-checkbox span {position:absolute;left:0;top:0;width:10dp;height:10dp;line-height:10dp;color:#ffe696;text-align:center;pointer-events:none;}
.weather-setting-label {position:absolute;left:23dp;top:0;height:28dp;line-height:28dp;font-size:7dp;white-space:nowrap;pointer-events:none;}
.weather-duration {position:absolute;right:3dp;top:3dp;width:88dp;height:22dp;}
.weather-step {position:absolute;top:0;width:19dp;height:21dp;line-height:19dp;text-align:center;background-color:#2e240f;border:1dp #8f794b;pointer-events:auto;cursor:pointer;}
.weather-step:hover {background-color:#58431a;}.weather-minus {left:0;}.weather-plus {right:0;}
.weather-duration-value {position:absolute;left:21dp;right:21dp;top:0;height:22dp;line-height:22dp;text-align:center;font-size:7dp;pointer-events:none;}
.weather-help {display:block;text-align:center;color:token(text-muted);font-size:6.5dp;line-height:12dp;padding:7dp 4dp;white-space:normal;}
.weather-quality-row {display:flex;flex-direction:row;width:100%;justify-content:space-between;gap:3dp;}
.weather-quality {position:relative;flex:1;height:24dp;line-height:24dp;text-align:center;border:1dp #6b5729;background-color:#1c170d;pointer-events:auto;cursor:pointer;}
.weather-quality span {display:block;width:100%;height:24dp;text-align:center;line-height:24dp;pointer-events:none;}
.weather-quality.selected {border-color:#f0cb61;color:#ffe3a2;background-color:#4b3712;}
.weather-slider-label {left:5dp;}
