@spritesheet mentor-art {
 src: ../paris-gold/Paris_MentorHomeV40.tga;
 mentor-home: 0px 0px 768px 512px;
}
@spritesheet mentor-find-art { src: ../paris-gold/Paris_MentorFindV34.tga; mentor-find: 0px 0px 768px 512px; }
@spritesheet mentor-rewards-art { src: ../paris-gold/Paris_MentorRewardsV40.tga; mentor-rewards: 0px 0px 768px 512px; }
@spritesheet mentor-history-art { src: ../paris-gold/Paris_MentorHistoryV40.tga; mentor-history: 0px 0px 768px 512px; }
#panel.paris-mentor { position: absolute; left: 50%; top: 0; margin-left: -300dp; width: 600dp; height: 400dp; color: #eee7d7; font-family: "token(font-body)"; font-size: 7dp; decorator: image(mentor-home); }
#panel.paris-mentor.find { decorator: image(mentor-find); }
#panel.paris-mentor.rewards { decorator: image(mentor-rewards); }
#panel.paris-mentor.history { decorator: image(mentor-history); }
.mentor-content, .mentor-home, .mentor-find, .mentor-offers, .mentor-history, .mentor-header, .mentor-tabs { position: absolute; left: 0; top: 0; width: 100%; height: 100%; pointer-events: none; }
.mentor-content *, .mentor-tabs * { pointer-events: auto; }
.mentor-tabs { z-index: 3; }
.action, .tab, .mentor-close { cursor: pointer; drag: block; text-align: center; }
.action:hover, .tab:hover, .tab.selected { background-color: #e0b84b29; }
.action.disabled { opacity: 0.4; cursor: default; }
.mentor-close { z-index: 5; }
.mentor-loading { position: absolute; left: 8%; top: 18%; width: 84%; height: 72%; padding-top: 16%; text-align: center; background-color: #080806f5; font-size: 9dp; }
.person-name, .offer-name, .history-heading, .detail-heading, .home-heading, .summary-heading, .find-heading, .top-heading, .recent-heading, .detail-name, .confirm-title { color: #f0d38a; font-weight: bold; }
.person-portrait { position: absolute; decorator: image(portrait-5); }
.mentor-query { border-width: 0; background-color: transparent; color: white; padding: 0; }
.query-placeholder { pointer-events: none; color: #aaa291; }
.active-fill { height: 100%; background-color: #1fcc1fb3; }
.home-recent, .find-people, .top-people, .history-rows, .history-details { position: absolute; }
.recent-row { display: block; position: relative; height: 17.96875dp; white-space: nowrap; }
.recent-age { position: absolute; right: 0; width: 30%; text-align: right; font-size: 6dp; }
.find-person { display: block; position: relative; height: 32.8125dp; }
.top-person { display: block; position: relative; height: 40.625dp; }
.history-row { display: block; position: relative; height: 26.953125dp; cursor: pointer; }
.history-row:hover, .home-person:hover { background-color: #e0b84b20; }
.detail-row { display: block; position: relative; height: 16.796875dp; }
.detail-value { position: absolute; left: 52%; width: 48%; }
.mentor-confirm-shade { position: absolute; left: 0; top: 0; width: 100%; height: 100%; background-color: #0009; z-index: 8; }
.mentor-confirm { background-color: #090907fa; border: 1dp #b8943b; }
.confirm-accept, .confirm-cancel { border: 1dp #b8943b; padding-top: 6dp; }
.offer-redeem { padding-top: 5dp; }
.offer-name, .offer-detail, .offer-cost { text-align: center; }
.offer-detail { font-size: 6dp; }
.offer-cost { color: #f0d38a; }
.mentor-status { color: #f0d38a; font-size: 6dp; }

