/* Center captions within the original artwork's individual fields. */
#panel.paris-mentor { text-align:center; }
#panel.paris-mentor .action, #panel.paris-mentor .tab { padding-top:0; padding-bottom:0; }
.mentor-tabs .tab { line-height:17.1875dp; }
.mentor-header > div, .find-role, .find-assigned, .find-requests { line-height:11.71875dp; }
.home-heading, .summary-heading, .find-heading, .top-heading, .recent-heading, .history-heading, .detail-heading, .detail-recent-heading { text-align:center; line-height:13.671875dp; }
.person-name, .person-detail, .person-extra { text-align:center; line-height:10.9375dp; }
.home-person .person-value, .home-person .person-extra { text-align:center; line-height:10.9375dp; }
.find-person .person-value { text-align:center; line-height:19.53125dp; }
.find-person .person-action { line-height:18.75dp; }
.top-person .person-value { text-align:center; line-height:13.671875dp; }
.home-accept, .home-reject { line-height:19.53125dp; }
.home-prev, .home-next { line-height:13.671875dp; }
.active-count { text-align:center; line-height:13.671875dp; }
.summary-points-label, .summary-graduated-label, .summary-hours-label, .summary-progress-label { text-align:center; line-height:12.5dp; }
.summary-points-value, .summary-graduated-value, .summary-hours-value, .summary-progress-value { text-align:center; line-height:14.84375dp; }
.reset-filter { line-height:16.796875dp; }
.mentor-query { line-height:10.9375dp; text-align:center; }
.query-placeholder { text-align:center; line-height:10.9375dp; }
.find-prev, .find-next, .offers-prev, .offers-next, .history-prev, .history-next { line-height:17.578125dp; }
.find-page, .history-page { line-height:11.71875dp; text-align:center; }
.link-cancel { line-height:14.84375dp; }
.offer-name { line-height:14.84375dp; }
.offer-detail { line-height:12.109375dp; }
.offer-cost { line-height:10.9375dp; }
.offer-redeem { line-height:21.09375dp; }
.history-filter { line-height:17.1875dp; }
.history-row > span, .history-head > span { text-align:center; }
.detail-row { text-align:center; line-height:16.796875dp; }
.detail-name, .detail-mentor, .detail-state { text-align:center; line-height:13.671875dp; }
.detail-event, .detail-date, .detail-points { text-align:center; line-height:11.71875dp; }
.history-close { line-height:25.390625dp; }
.confirm-title { text-align:center; line-height:13.671875dp; }
.confirm-description { text-align:center; line-height:27.34375dp; }
.confirm-accept, .confirm-cancel { line-height:22.265625dp; }
.mentor-status { text-align:center; line-height:11.71875dp; }

/* The history background has three fixed tab cells, unlike the four-cell search background. */
#panel.history .novice-tabs .tab-find { left:21.484375%; width:18.5546875%; }
#panel.history .novice-tabs .tab-history { left:60.546875%; width:18.5546875%; }
.mentor-header > div, .find-role, .find-assigned, .find-requests { text-align:center; }
.history-head > span { top:0; height:100%; line-height:11.71875dp; }
.history-row > span { top:0; height:100%; display:flex; align-items:center; justify-content:center; text-align:center; line-height:8.5dp; }
.history-row .history-date { font-size:6.5dp; }
.detail-row > span { position:absolute; left:0; top:0; width:46.218487%; height:100%; text-align:center; }
.detail-row > .detail-value { left:52.10084%; width:47.89916%; }
.detail-state { top:29.8828125%; height:5.078125%; display:flex; align-items:center; justify-content:center; text-align:center; line-height:8dp; }
.detail-event, .detail-date, .detail-points, .detail-name, .detail-mentor { text-align:center; }
.home-recent .recent-row > span { display:block; width:66%; text-align:center; line-height:17.96875dp; }
.home-recent .recent-row > .recent-age { top:0; left:auto; right:0; width:30%; text-align:center; }

/* Keep history details within the artwork's horizontal separators. */
.history-details { top: 38.867188%; }
.detail-heading { top: 23.4375%; }
.detail-recent-heading { top: 61.230469%; }
.history-row > span { display: block; line-height: 26.953125dp; }
.history-row .history-date { line-height: 12dp; padding-top: 1.5dp; }
.detail-state { display: block; line-height: 10dp; padding-top: 1dp; }

/* Match selector specificity of the original cells, keeping every baseline inside its row. */
.history-row .history-date, .history-row .history-name, .history-row .history-kind, .history-row .history-points { top: 0; height: 100%; padding-top: 0; line-height: 26.953125dp; text-align: center; }
.history-details .detail-row { line-height: 9dp; }
.history-details .detail-row > span { line-height: 9dp; text-align: center; }

/* Center text inside the original status and lower close cells. */
.detail-name {top:29.5%;line-height:10dp;}
.detail-mentor {top:33.5%;line-height:10dp;}
.detail-state {left:83.2%;top:29.4%;width:11.5%;height:5.2%;padding:0;white-space:normal;overflow:hidden;}
.detail-state > span {position:absolute;display:block;left:3%;top:2dp;width:94%;height:100%;font-size:6.5dp;line-height:8dp;text-align:center;white-space:normal;}
.history-close {left:81.6%;top:88%;width:13.8%;height:6.3%;padding:0;}
.history-close > span {position:absolute;display:block;left:0;top:0;width:100%;height:100%;line-height:25dp;text-align:center;pointer-events:none;}

/* Loading stays in the footer; the artwork and tabs remain available during a refresh. */
.mentor-loading {left:8%;top:94%;width:70%;height:4%;padding:0;background-color:transparent;font-size:7dp;line-height:12dp;pointer-events:none;z-index:4;}
.mentor-content.pending .history-rows,.mentor-content.pending .history-details,.mentor-content.pending .find-people,.mentor-content.pending .top-people {visibility:hidden;}
