.party-row { height: 58px; background-color: #000; }
.party-row .gbox-title-fill, .party-row .gbox-content-fill, .party-row .gbox-corner, .party-row .gbox-edge { visibility: hidden; }
.party-name { left: 3px; top: 3px; text-align: left; }
.party-level { position: absolute; left: 70px; top: 3px; width: calc(97px * var(--root-scale,1)); }
.party-map { left: 3px; top: 15px; }
.party-coord { left: 88px; top: 15px; width: calc(46px * var(--root-scale,1)); }
.party-flag, .party-kick-btn { top: 15px; }
.party-hp-bar, .party-mana-bar { position: absolute; left: 3px; top: 27px; width: 80px; height: 6px; border: 1px #555; box-sizing: border-box; background-color: #101010; }
.party-mana-bar { left: 86px; }
.party-hp-fill { height: 4px; background-color: #db1414; decorator: none; }
.party-mana-fill { height: 4px; background-color: #1459f2; }
.party-hp-text, .party-mana-text { position: absolute; left: 3px; top: 35px; width: calc(80px * var(--root-scale,1)); text-align: left; }
.party-mana-text { left: 86px; }
.party-level, .party-hp-text, .party-mana-text { font-family: "Tahoma"; font-size: var(--text-px,13px); font-weight: normal; transform-origin: left top; transform: scale(calc(1 / var(--root-scale,1))); color: #c2c2c2; }
.party-buffs { position: absolute; left: 3px; top: 45px; width: 160px; height: 11px; }
.party-buff { display: inline-block; width: 9px; height: 11px; margin-right: 3px; }
.settings-follow-value { top: 85px; }
.settings-follow { top: 103px; }
.settings-auto-value { top: 138px; }
.settings-auto { top: 156px; }
.settings-buffs { top: 193px; }
.settings-summon { top: 223px; }
.settings-leader-only { top: 265px; }

/* Stacked checkbox rows keep all Party settings readable. */
.party-settings .party-setting-check { left: 0; width: 166px; height: 28px; border-width: 0; padding: 0; background-color: transparent; decorator: none; text-align: left; }
.party-check-square { position: absolute; left: 0; top: 0; width: 12px; height: 12px; border: 1px #9b8047; background-color: #080808; box-sizing: border-box; }
.party-check-tick { display: block; text-align: center; color: #efe0ba; font-size: 11px; line-height: 10px; font-weight: bold; }
.party-check-label { position: absolute; left: 19px; top: 2px; width: calc(147px * var(--root-scale,1)); font-family: "Tahoma"; font-size: var(--text-px,13px); font-weight: normal; line-height: 1.15; color: #ebe0c8; transform-origin: left top; transform: scale(calc(1 / var(--root-scale,1))); }
.party-setting-check.disabled .party-check-label { color: #7d786c; }
.settings-privacy { top: 15px; }
.settings-follow { top: 53px; }
.settings-auto { top: 91px; }
.settings-buffs { top: 129px; }
.settings-summon { top: 167px; }
.settings-leader-only { top: 225px; }

/* Child text must not intercept checkbox input or override bound hidden state. */
.party-setting-check .party-check-square, .party-setting-check .party-check-tick, .party-setting-check .party-check-label { pointer-events: none; }
.party-setting-check .party-check-tick { position: absolute; left: 0; top: 0; width: 10px; height: 10px; line-height: 10px; font-family: "Tahoma"; font-size: 10px; text-align: center; }
.party-settings .party-setting-check.hidden, .party-setting-check .party-check-tick.hidden { display: none; }

.party-settings .party-setting-check { height: 34px; pointer-events: auto; }
.party-settings .party-setting-check:hover .party-check-square { border-color: #f0cf73; }

.party-hp-fill, .party-mana-fill { display: block; position: absolute; left: 0; top: 0; height: 4px; max-width: 78px; pointer-events: none; }

.party-map, .party-coord { color: #fff; opacity: 1; }
