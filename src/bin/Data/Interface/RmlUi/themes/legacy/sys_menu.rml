<rml>
<head><title>Paris Project Menu</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="sys_menu.rcss"/>
	<link type="text/rcss" href="paris_dialog_frame.rcss"/>
	<link type="text/rcss" href="paris_subtle_button.rcss"/></head>
<body class="scene-window-scale">
 <div id="backdrop"></div>
 <div id="panel" class="center-both" data-class-compact="select_server_hidden" data-model="sys_menu">
  <div id="panel_middle"></div>
  <div class="dialog-heading-line dialog-heading-left"></div>
		<div class="dialog-heading-line dialog-heading-right"></div>
  <div class="menu-title">{{system_menu_label}}</div>
  <div id="btn_exit_game" class="btn paris-small-button" data-event-click="sysmenu_exit_game_click">{{exit_game_label}}</div>
  <div id="btn_select_server" class="btn paris-small-button" data-class-hidden="select_server_hidden" data-event-click="sysmenu_select_server_click">{{select_server_label}}</div>
  <div id="btn_option" class="btn paris-small-button" data-event-click="sysmenu_option_click">{{option_label}}</div>
  <div id="btn_close" class="btn paris-small-button" data-event-click="sysmenu_close_click">{{close_label}}</div>
 </div>
</body></rml>
