<rml>
<head>
    <title>VIP Paris</title>
    <link type="text/rcss" href="base.rcss" />
    <link type="text/rcss" href="docked_panel_frame.rcss" />
    <link type="text/rcss" href="paris_panel.rcss" />
    <link type="text/rcss" href="paris_vip.rcss" />
</head>
<body data-model="paris_vip">
    <div id="panel" class="paris-vip">
        <div class="frame-piece frame-top"></div><div class="frame-piece frame-left"></div>
        <div class="frame-piece frame-right"></div><div class="frame-piece frame-bottom"></div>
        <span id="title" class="sharp-text">VIP SYSTEM</span>
        <div id="frame_corner_close" data-event-click="paris_vip_close"></div>
        <div class="vip-account sharp-text"><span>Estado Cuenta:</span><strong>{{current_tier}}</strong></div>
        <div class="vip-plans">
            <div class="vip-plan" data-class-selected="plan == 1" data-event-click="paris_vip_plan(1)"><span class="vip-plan-icon vip-icon-1"></span><span class="vip-plan-label sharp-text">VIP 1</span></div>
            <div class="vip-plan" data-class-selected="plan == 2" data-event-click="paris_vip_plan(2)"><span class="vip-plan-icon vip-icon-2"></span><span class="vip-plan-label sharp-text">VIP 2</span></div>
            <div class="vip-plan" data-class-selected="plan == 3" data-event-click="paris_vip_plan(3)"><span class="vip-plan-icon vip-icon-3"></span><span class="vip-plan-label sharp-text">VIP 3</span></div>
        </div>
        <div class="vip-divider vip-divider-tabs"></div>
        <div class="vip-details" data-if="has_data">
            <div class="vip-plan-name sharp-text">{{plan_name}}</div>
            <div class="vip-meta sharp-text"><span>Tiempo restante: {{selected_days}} días</span><span>Duración: {{duration}}</span></div>
            <div class="vip-divider vip-divider-benefits"></div>
            <tabset class="vip-page-set">
                <tab class="vip-arrow vip-arrow-prev">&#8592; Anterior</tab>
                <tab class="vip-arrow vip-arrow-next">Siguiente &#8594;</tab>
                <panels>
                    <panel>
                        <div class="vip-section-title sharp-text">BENEFICIOS · 1 / 2</div>
                        <div class="vip-benefits">
                            <div data-for="line, index : benefits">
                                <div class="vip-line" data-if="index &gt;= 5 || line.label == 'Experiencia' || line.label == 'Exp. Master' || line.label == 'Zen al matar' || line.label == 'Chance de drop'">
                                    <span class="vip-benefit-label sharp-text">{{line.label}}</span><strong class="vip-benefit-value sharp-text">{{line.value}}</strong>
                                </div>
                            </div>
                        </div>
                    </panel>
                    <panel>
                        <div class="vip-section-title sharp-text">JOYAS Y MÁQUINA CHAOS · 2 / 2</div>
                        <div class="vip-benefits">
                            <div data-for="line, index : benefits">
                                <div class="vip-line" data-if="index &lt; 5 &amp;&amp; line.label != 'Experiencia' &amp;&amp; line.label != 'Exp. Master' &amp;&amp; line.label != 'Zen al matar' &amp;&amp; line.label != 'Chance de drop'">
                                    <span class="vip-benefit-label sharp-text" data-if="line.value != ''">{{line.label}}</span><strong class="vip-benefit-value sharp-text" data-if="line.value != ''">{{line.value}}</strong>
                                    <span class="vip-benefit-label sharp-text" data-if="line.text == 'Joyas (extra prom.): +3.33 pp' || line.text == 'Joyas (extra prom.): +6.67 pp' || line.text == 'Joyas (extra prom.): +11.67 pp'">Joyas (promedio)</span>
                                    <strong class="vip-benefit-value sharp-text" data-if="line.text == 'Joyas (extra prom.): +3.33 pp' || line.text == 'Joyas (extra prom.): +6.67 pp' || line.text == 'Joyas (extra prom.): +11.67 pp'">{{line.text == 'Joyas (extra prom.): +3.33 pp' ? '+3.33 pp' : line.text == 'Joyas (extra prom.): +6.67 pp' ? '+6.67 pp' : line.text == 'Joyas (extra prom.): +11.67 pp' ? '+11.67 pp' : ''}}</strong>
                                    <span class="vip-benefit-label sharp-text" data-if="line.text == 'Chaos (extra prom.): +5.86 pp' || line.text == 'Chaos (extra prom.): +9.68 pp' || line.text == 'Chaos (extra prom.): +13.64 pp'">Máquina Chaos (prom.)</span>
                                    <strong class="vip-benefit-value sharp-text" data-if="line.text == 'Chaos (extra prom.): +5.86 pp' || line.text == 'Chaos (extra prom.): +9.68 pp' || line.text == 'Chaos (extra prom.): +13.64 pp'">{{line.text == 'Chaos (extra prom.): +5.86 pp' ? '+5.86 pp' : line.text == 'Chaos (extra prom.): +9.68 pp' ? '+9.68 pp' : line.text == 'Chaos (extra prom.): +13.64 pp' ? '+13.64 pp' : ''}}</strong>
                                    <span class="vip-rate-summary sharp-text" data-if="line.value == '' &amp;&amp; line.text != 'Joyas (extra prom.): +3.33 pp' &amp;&amp; line.text != 'Joyas (extra prom.): +6.67 pp' &amp;&amp; line.text != 'Joyas (extra prom.): +11.67 pp' &amp;&amp; line.text != 'Chaos (extra prom.): +5.86 pp' &amp;&amp; line.text != 'Chaos (extra prom.): +9.68 pp' &amp;&amp; line.text != 'Chaos (extra prom.): +13.64 pp'">{{line.text}}</span>
                                </div>
                            </div>
                        </div>
                    </panel>
                </panels>
            </tabset>
            <div class="vip-divider vip-divider-costs"></div>
            <div class="vip-section-title cost-title sharp-text" data-if="!empty">COSTO</div>
            <div class="vip-costs"><div class="vip-cost sharp-text" data-for="line : costs">{{line.text}}</div></div>
            <div class="vip-empty sharp-text" data-if="empty">El servidor no envió detalles para este plan.</div>
        </div>
        <div class="vip-wait sharp-text" data-if="!has_data" data-event-click="paris_vip_refresh">{{status}}</div>
        <div class="vip-actions">
            <div class="vip-button primary" data-if="has_data" data-class-disabled="!can_buy" data-event-click="paris_vip_purchase">COMPRAR VIP</div>
        </div>
    </div>
</body>
</rml>
