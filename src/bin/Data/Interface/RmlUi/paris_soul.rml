<rml><head><title>Soul System</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_soul.rcss"/></head>
<!-- bound-geometry: server milestones position markers on their rank meter; the current draft fills that meter. -->
<body data-model="paris_soul"><div id="panel" class="soul-panel">
<div class="soul-frame frame-tl"></div><div class="soul-frame frame-t"></div><div class="soul-frame frame-tr"></div><div class="soul-frame frame-l"></div><div class="soul-frame frame-r"></div><div class="soul-frame frame-bl"></div><div class="soul-frame frame-b"></div><div class="soul-frame frame-br"></div>
<div class="soul-title">Soul System</div><div id="frame_corner_close" class="soul-close" data-event-click="soul_close"></div>
<div class="soul-tab tab-0" data-class-active="category == 0" data-event-click="soul_tab(0)"><span class="tab-icon"></span><span class="soul-tab-label">Ataque</span></div>
<div class="soul-tab tab-1" data-class-active="category == 1" data-event-click="soul_tab(1)"><span class="tab-icon"></span><span class="soul-tab-label">Defensa</span></div>
<div class="soul-tab tab-2" data-class-active="category == 2" data-event-click="soul_tab(2)"><span class="tab-icon"></span><span class="soul-tab-label">Soporte</span></div>
<div class="soul-tab tab-3" data-class-active="category == 3" data-event-click="soul_tab(3)"><span class="tab-icon"></span><span class="soul-tab-label">Miscelánea</span></div>
<div class="soul-remaining">{{remaining}}</div>
<div class="soul-column" data-for="column : columns" data-class-col-0="column.index == 0" data-class-col-1="column.index == 1" data-class-col-2="column.index == 2" data-class-col-3="column.index == 3" data-if="!loading">
<div class="soul-column-back"></div><div class="soul-caption-mask"></div><div class="soul-label-mask"></div><div class="soul-tier-mask"></div><div class="soul-cursor-patch"></div><div class="soul-orb"></div><div class="soul-orb-effects" data-class-defense="category == 1" data-class-support="category == 2" data-class-misc="category == 3" data-style-opacity="column.rank > 0 ? 0.95 : 0.65"><span class="soul-aura"></span><span class="soul-ring"></span><span class="soul-ring-inner"></span><span class="soul-particle p0"><span class="mote-halo"></span><span class="mote-tail-two"></span><span class="mote-tail"></span><span class="mote-core"></span></span><span class="soul-particle p1"><span class="mote-halo"></span><span class="mote-tail-two"></span><span class="mote-tail"></span><span class="mote-core"></span></span><span class="soul-particle p2"><span class="mote-halo"></span><span class="mote-tail-two"></span><span class="mote-tail"></span><span class="mote-core"></span></span><span class="soul-particle p3"><span class="mote-halo"></span><span class="mote-tail-two"></span><span class="mote-tail"></span><span class="mote-core"></span></span><span class="soul-particle p4"><span class="mote-halo"></span><span class="mote-tail-two"></span><span class="mote-tail"></span><span class="mote-core"></span></span><span class="soul-particle p5"><span class="mote-halo"></span><span class="mote-tail-two"></span><span class="mote-tail"></span><span class="mote-core"></span></span><span class="soul-particle p6"><span class="mote-halo"></span><span class="mote-tail-two"></span><span class="mote-tail"></span><span class="mote-core"></span></span></div><div class="soul-name">{{column.name}}</div><div class="soul-benefit">{{column.benefit}}</div>
<div class="soul-rank-controls">
<button class="rank-sub-ten" data-attrif-disabled="!column.subtract" data-event-click="soul_rank(column.index, -10)"><span>-10</span></button><button class="rank-sub-one" data-attrif-disabled="!column.subtract" data-event-click="soul_rank(column.index, -1)"><span>-1</span></button><div class="soul-rank"><span>{{column.rank}}</span></div><button class="rank-add-one" data-attrif-disabled="!column.add" data-event-click="soul_rank(column.index, 1)"><span>+1</span></button><button class="rank-add-ten" data-attrif-disabled="!column.add" data-event-click="soul_rank(column.index, 10)"><span>+10</span></button></div>
<div class="soul-meter"><div class="soul-meter-fill" data-style-height="column.progress"></div></div>
<div class="soul-tiers"><div class="soul-tier" data-for="tier : column.tiers" data-style-top="tier.top" data-class-tier-0="tier.index == 0" data-class-tier-1="tier.index == 1" data-class-tier-2="tier.index == 2" data-class-unlocked="tier.unlocked" data-attr-data-hint="tier.hint"><span class="soul-tier-rank">{{tier.rank}}</span><span class="soul-tier-art"></span><span class="soul-lock" data-if="!tier.unlocked"><span class="soul-lock-shackle"></span><span class="soul-lock-key"></span></span></div></div></div>
<div class="soul-status">{{status}}</div>
<button class="soul-reset" data-attrif-disabled="!can_reset" data-event-click="soul_reset"><span>Reiniciar</span></button><button class="soul-cancel" data-attrif-disabled="pending" data-event-click="soul_cancel"><span>Cancelar</span></button><button class="soul-apply" data-attrif-disabled="!can_apply" data-event-click="soul_apply"><span>Aceptar</span></button><button class="soul-exit" data-event-click="soul_close"><span>Cerrar</span></button>
<div class="soul-confirm-overlay" data-if="confirm_reset"><div class="soul-confirm"><div>{{confirmation}}</div><button data-event-click="soul_confirm"><span>Aceptar</span></button><button data-event-click="soul_dismiss"><span>Cancelar</span></button></div></div>
</div></body></rml>