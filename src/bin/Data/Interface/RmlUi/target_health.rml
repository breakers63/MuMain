<!-- bound-geometry: percent is the server HP fraction filling the gauge, not panel layout. --><rml><head><title>Target health</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="target_health.rcss"/></head><body data-model="target_health"><div id="target-health"><div class="target-name">{{name}}</div><div class="target-track"><div class="target-fill" data-style-width="percent + '%'"/></div><div class="target-percent">{{remaining}}</div><div class="damage-ranking" data-rml="ranking"/></div></body></rml>
