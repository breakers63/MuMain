/* Right-edge, fixed square icons; the shared dp scale preserves their proportions.
   Vertical placement matches the approved 640x480 OpenGL layout (181/480). */
@spritesheet paris-shortcut-sheet {
    src: "../Paris_RightShortcuts.tga";
    paris-shortcut-menu: 40px 38px 580px 558px;
    paris-shortcut-missions: 635px 38px 596px 558px;
    paris-shortcut-events: 40px 626px 580px 580px;
    paris-shortcut-reset: 635px 626px 596px 580px;
}
#paris_shortcut_anchor {position:absolute;left:0;top:37.7083%;width:100%;height:104dp;display:flex;justify-content:flex-end;pointer-events:none;}
#paris_shortcuts {display:block;flex-shrink:0;width:24dp;height:104dp;margin-right:5dp;pointer-events:none;}
#paris_shortcuts.hidden {display:none;}
.paris-shortcut {display:block;width:24dp;height:24dp;margin-bottom:2dp;pointer-events:auto;cursor:pointer;opacity:0.88;}
.paris-shortcut:hover {opacity:1;}
.shortcut-menu {decorator:image(paris-shortcut-menu);}
.shortcut-missions {decorator:image(paris-shortcut-missions);}
.shortcut-events {decorator:image(paris-shortcut-events);}
.shortcut-reset {decorator:image(paris-shortcut-reset);}
#btn_window, #btn_window_top {display:none;}
