<rml><head><title>Vender artículo</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_store_price.rcss"/></head>
<body data-model="paris_store_price"><div id="panel" class="store-price-panel">
<div class="price-stone"></div><div class="price-frame price-frame-tl"></div><div class="price-frame price-frame-t"></div><div class="price-frame price-frame-tr"></div><div class="price-frame price-frame-l"></div><div class="price-frame price-frame-r"></div><div class="price-frame price-frame-bl"></div><div class="price-frame price-frame-b"></div><div class="price-frame price-frame-br"></div><div class="price-crest"></div><div class="price-heading"></div><div class="price-header-line"></div><div id="frame_corner_close" class="price-close" data-event-click="price_cancel">×</div>
<div class="price-item-frame"><img id="price-item"/></div>
<div class="price-rows"><div class="price-row" data-for="row : rows" data-class-selected="row.amount != '0'" data-class-disabled="!row.enabled" data-class-zen="row.index == 0" data-class-paris="row.index == 1" data-class-bless="row.index == 2" data-class-soul="row.index == 3" data-class-life="row.index == 4" data-class-creation="row.index == 5" data-class-chaos="row.index == 6"><div class="price-currency-icon" data-if="row.index &lt; 2"></div><img class="price-currency-icon price-jewel-icon" data-if="row.index &gt; 1"/><span class="price-label">{{row.name}}</span><input type="text" maxlength="10" data-value="row.amount" data-attrif-disabled="!row.enabled"/><button class="price-up" data-attrif-disabled="!row.enabled" data-event-click="price_adjust(row.index, 1)"><span>▲</span></button><button class="price-down" data-attrif-disabled="!row.enabled" data-event-click="price_adjust(row.index, -1)"><span>▼</span></button></div></div>
<div class="price-status">{{status}}</div><div class="price-publish" data-event-click="price_apply"></div><div class="price-cancel" data-event-click="price_cancel"></div>
</div></body></rml>