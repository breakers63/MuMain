<rml>
<head><title>Eventos Paris</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_events.rcss"/></head>
<body data-model="paris_events">
<div id="panel" class="paris-event-guide"><div class="guide-skin"></div><div class="guide-panel-fill"></div><div class="guide-chrome-top"></div><div class="guide-chrome-left"></div><div class="guide-chrome-right"></div><div class="guide-chrome-bottom"></div>
 <div class="guide-corner tl"></div><div class="guide-corner tr"></div><div class="guide-corner bl"></div><div class="guide-corner br"></div>
 <div class="guide-header" id="title"><div class="guide-dragon left"></div><div class="guide-brand">PARIS PROJECT</div><div class="guide-heading">EVENTOS</div><div class="guide-dragon right"></div></div>
 <button class="guide-x" data-event-click="paris_event_close">X</button>
 <div class="guide-sidebar"><div class="guide-ornament"><i class="edge-tl"></i><i class="edge-t"></i><i class="edge-tr"></i><i class="edge-l"></i><i class="edge-r"></i><i class="edge-bl"></i><i class="edge-b"></i><i class="edge-br"></i></div>
  <div class="guide-category-title" data-class-bosses="category == 'JEFES'" data-class-invasions="category == 'INVASIONES'" data-class-dungeons="category == 'MAZMORRAS · CUSTOMS'" data-class-wide="category == 'MAZMORRAS · CUSTOMS'"><i class="category-cap left"></i><i class="category-cap right"></i><span>{{category}}</span></div><div class="guide-list-title">EVENTO <span>ESTADO</span></div>
  <div class="guide-events"><button class="guide-event" data-for="event : events" data-class-selected="event.selected" data-event-click="paris_event_select(event.key)"><div class="guide-ornament"><i class="edge-tl"></i><i class="edge-t"></i><i class="edge-tr"></i><i class="edge-l"></i><i class="edge-r"></i><i class="edge-bl"></i><i class="edge-b"></i><i class="edge-br"></i></div><div class="guide-event-portrait"><i class="art-devil-square" data-if="event.key == 'mini-1'"></i><i class="art-blood-castle" data-if="event.key == 'mini-2'"></i><i class="art-chaos-castle" data-if="event.key == 'mini-3'"></i><i class="art-illusion-temple" data-if="event.key == 'mini-4'"></i><i class="art-doppelganger" data-if="event.key == 'mini-5'"></i><i class="art-imperial-guardian" data-if="event.key == 'mini-7'"></i><i class="art-raklion" data-if="event.key == 'raklion'"></i><i class="art-refinery" data-if="event.key == 'mini-6'"></i><i class="art-castle-siege" data-if="event.key == 'castle-siege'"></i><i class="art-red-dragon" data-if="event.key == 'timer-4'"></i><i class="art-golden-invasion" data-if="event.key == 'timer-5'"></i><i class="art-white-wizard" data-if="event.key == 'timer-6'"></i><i class="art-erohim" data-if="event.key == 'timer-7'"></i><i class="art-kundun" data-if="event.key == 'timer-8'"></i><i class="art-happy-hour" data-if="event.key == 'timer-9'"></i><i class="art-medusa" data-if="event.key == 'timer-15'"></i><i class="art-gaion" data-if="event.key == 'timer-16'"></i><i class="art-fortune" data-if="event.key == 'timer-17'"></i><i class="art-mini-1" data-if="event.key == 'timer-10'"></i><i class="art-mini-2" data-if="event.key == 'timer-11'"></i><i class="art-mini-3" data-if="event.key == 'timer-12'"></i><i class="art-mini-4" data-if="event.key == 'timer-13'"></i><i class="art-mini-5" data-if="event.key == 'timer-14'"></i><i class="art-kardamahal" data-if="event.key == 'dungeon-0'"></i><i class="art-kanturu" data-if="event.key == 'dungeon-1'"></i><i class="art-crywolf" data-if="event.key == 'dungeon-3'"></i><i class="art-karutan" data-if="event.key == 'dungeon-4'"></i><i class="art-generals" data-if="event.key == 'custom-generals'"></i><i class="art-race" data-if="event.key == 'custom-race'"></i><i class="art-fugitive" data-if="event.key == 'custom-fugitive'"></i><i class="art-tower" data-if="event.key == 'custom-tower'"></i><i class="art-tvt" data-if="event.key == 'custom-tvt'"></i><i class="art-guild-battle" data-if="event.key == 'custom-guild-battle'"></i><i class="art-king" data-if="event.key == 'custom-king-of-mu'"></i><i class="art-sky" data-if="event.key == 'custom-sky'"></i><i class="art-arena-0" data-if="event.key == 'custom-arena-0'"></i><i class="art-arena-1" data-if="event.key == 'custom-arena-1'"></i><i class="art-arena-2" data-if="event.key == 'custom-arena-2'"></i><i class="art-arena-3" data-if="event.key == 'custom-arena-3'"></i><i class="art-arena-5" data-if="event.key == 'custom-arena-5'"></i><i class="art-arena-6" data-if="event.key == 'custom-arena-6'"></i></div><span class="guide-event-name" data-if="event.key == 'mini-1'">Devil Square</span><span class="guide-event-name" data-if="event.key == 'mini-2'">Blood Castle</span><span class="guide-event-name" data-if="event.key == 'mini-3'">Chaos Castle</span><span class="guide-event-name" data-if="event.key == 'mini-4'">Illusion Temple</span><span class="guide-event-name" data-if="event.key == 'mini-5'">Doppelganger</span><span class="guide-event-name" data-if="event.key == 'mini-7'">Imperial Guardian</span><span class="guide-event-name" data-if="event.key != &#x27;mini-1&#x27; &amp;&amp; event.key != &#x27;mini-2&#x27; &amp;&amp; event.key != &#x27;mini-3&#x27; &amp;&amp; event.key != &#x27;mini-4&#x27; &amp;&amp; event.key != &#x27;mini-5&#x27; &amp;&amp; event.key != &#x27;mini-7&#x27;">{{event.name}}</span><strong data-class-live="event.state == 1">{{event.value}}</strong></button><p data-if="empty">Consultando al servidor...</p></div>
<div class="guide-boss-showcase" data-if="category == 'JEFES'"><button data-event-click="paris_event_select('timer-7')"><i class="portrait-erohim"></i><span>Erohim</span></button><button data-event-click="paris_event_select('timer-15')"><i class="portrait-medusa"></i><span>Medusa</span></button><button data-event-click="paris_event_select('raklion')"><i class="portrait-raklion"></i><span>Raklion</span></button></div>
  <div class="guide-paging"><button data-event-click="paris_event_page(-1)">&lt;</button><span>{{page}} / {{pages}}</span><button data-event-click="paris_event_page(1)">&gt;</button></div>
 </div>
 <div class="guide-detail">
  <p class="guide-wait" data-if="!has_detail">Consultando eventos, requisitos y horarios del servidor...</p>
  <div class="guide-content" data-if="has_detail">
   <div class="guide-detail-title"><div class="guide-title-frame"><i class="title-left"></i><i class="title-top"></i><i class="title-bottom"></i><i class="title-right"></i></div><h3 data-if="title == 'Devil Square' || title == 'Devil Square 1' || title == 'Devil Square 2' || title == 'Devil Square 3' || title == 'Devil Square 4' || title == 'Devil Square 5' || title == 'Devil Square 6' || title == 'Devil Square 7' || title == 'Devil Square 8'">Devil Square</h3><h3 data-if="title == 'Blood Castle' || title == 'Blood Castle 1' || title == 'Blood Castle 2' || title == 'Blood Castle 3' || title == 'Blood Castle 4' || title == 'Blood Castle 5' || title == 'Blood Castle 6' || title == 'Blood Castle 7' || title == 'Blood Castle 8'">Blood Castle</h3><h3 data-if="title == 'Chaos Castle' || title == 'Chaos Castle 1' || title == 'Chaos Castle 2' || title == 'Chaos Castle 3' || title == 'Chaos Castle 4' || title == 'Chaos Castle 5' || title == 'Chaos Castle 6' || title == 'Chaos Castle 7' || title == 'Chaos Castle 8'">Chaos Castle</h3><h3 data-if="title == 'Illusion Temple' || title == 'Illusion Temple 1' || title == 'Illusion Temple 2' || title == 'Illusion Temple 3' || title == 'Illusion Temple 4' || title == 'Illusion Temple 5' || title == 'Illusion Temple 6' || title == 'Illusion Temple 7' || title == 'Illusion Temple 8'">Illusion Temple</h3><h3 data-if="title == 'Doppelganger' || title == 'Doppelganger 1' || title == 'Doppelganger 2' || title == 'Doppelganger 3' || title == 'Doppelganger 4' || title == 'Doppelganger 5' || title == 'Doppelganger 6' || title == 'Doppelganger 7' || title == 'Doppelganger 8'">Doppelganger</h3><h3 data-if="title == 'Imperial Guardian' || title == 'Imperial Guardian 1' || title == 'Imperial Guardian 2' || title == 'Imperial Guardian 3' || title == 'Imperial Guardian 4' || title == 'Imperial Guardian 5' || title == 'Imperial Guardian 6' || title == 'Imperial Guardian 7' || title == 'Imperial Guardian 8' || title == 'Imperial Guardian Monday' || t