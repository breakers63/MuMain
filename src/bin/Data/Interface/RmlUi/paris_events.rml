rial Guardian Tuesday' || title == 'Imperial Guardian Wednesday' || title == 'Imperial Guardian Thursday' || title == 'Imperial Guardian Friday' || title == 'Imperial Guardian Saturday' || title == 'Imperial Guardian Sunday' || title == 'Raklion')">{{title}}</h3><span class="guide-phase" data-class-live="phase == 'Disponible' || phase == 'En curso' || phase == 'Inscripciones abiertas'">{{phase}}</span></div>
   <div class="guide-banner"><div class="guide-landscape art-devil-square" data-if="title == &#x27;Devil Square&#x27; || title == &#x27;Devil Square 1&#x27; || title == &#x27;Devil Square 2&#x27; || title == &#x27;Devil Square 3&#x27; || title == &#x27;Devil Square 4&#x27; || title == &#x27;Devil Square 5&#x27; || title == &#x27;Devil Square 6&#x27; || title == &#x27;Devil Square 7&#x27; || title == &#x27;Devil Square 8&#x27;"></div><div class="guide-landscape art-blood-castle" data-if="title == &#x27;Blood Castle&#x27; || title == &#x27;Blood Castle 1&#x27; || title == &#x27;Blood Castle 2&#x27; || title == &#x27;Blood Castle 3&#x27; || title == &#x27;Blood Castle 4&#x27; || title == &#x27;Blood Castle 5&#x27; || title == &#x27;Blood Castle 6&#x27; || title == &#x27;Blood Castle 7&#x27; || title == &#x27;Blood Castle 8&#x27;"></div><div class="guide-landscape art-chaos-castle" data-if="title == &#x27;Chaos Castle&#x27; || title == &#x27;Chaos Castle 1&#x27; || title == &#x27;Chaos Castle 2&#x27; || title == &#x27;Chaos Castle 3&#x27; || title == &#x27;Chaos Castle 4&#x27; || title == &#x27;Chaos Castle 5&#x27; || title == &#x27;Chaos Castle 6&#x27; || title == &#x27;Chaos Castle 7&#x27; || title == &#x27;Chaos Castle 8&#x27;"></div><div class="guide-landscape art-illusion-temple" data-if="title == &#x27;Illusion Temple&#x27; || title == &#x27;Illusion Temple 1&#x27; || title == &#x27;Illusion Temple 2&#x27; || title == &#x27;Illusion Temple 3&#x27; || title == &#x27;Illusion Temple 4&#x27; || title == &#x27;Illusion Temple 5&#x27; || title == &#x27;Illusion Temple 6&#x27; || title == &#x27;Illusion Temple 7&#x27; || title == &#x27;Illusion Temple 8&#x27;"></div><div class="guide-landscape art-doppelganger" data-if="title == &#x27;Doppelganger&#x27; || title == &#x27;Doppelganger 1&#x27; || title == &#x27;Doppelganger 2&#x27; || title == &#x27;Doppelganger 3&#x27; || title == &#x27;Doppelganger 4&#x27; || title == &#x27;Doppelganger 5&#x27; || title == &#x27;Doppelg