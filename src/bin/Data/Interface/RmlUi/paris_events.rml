<rml><head><title>Eventos</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="docked_panel_frame.rcss"/><link type="text/rcss" href="paris_panel.rcss"/><link type="text/rcss" href="paris_events.rcss"/></head><body data-model="paris_events"><div id="panel" class="paris-events"><div class="frame-piece frame-top"></div><div class="frame-piece frame-left"></div><div class="frame-piece frame-right"></div><div class="frame-piece frame-bottom"></div><span id="title">{{title}}</span><div id="frame_corner_close" data-event-click="paris_event_close"></div><div class="event-head"><span class="event-name">Evento</span><span class="event-remaining">Restante</span><span class="event-state">Estado</span></div><div class="event-list"><div class="event-row" data-for="event : events" data-class-active="event.active" data-class-alternate="event.index % 2 == 0"><span class="event-name">{{event.name}}</span><span class="event-remaining">{{event.remaining}}</span><span class="event-state">{{event.state}}</span></div><div class="event-empty" data-if="empty">No hay eventos en esta categoría.</div></div><div class="event-prev" data-event-click="paris_event_page(-1)">◀</div><div class="event-page">Página {{page}}/5</div><div class="event-next" data-event-click="paris_event_page(1)">▶</div><div class="event-status" data-attr-title="status">H o ESC para cerrar</div><div class="event-hidden-tabs"><span data-for="tab : tabs" data-event-click="paris_event_tab(tab.index)">{{tab.label}}</span></div></div></body></rml>