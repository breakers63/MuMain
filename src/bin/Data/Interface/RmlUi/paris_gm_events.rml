<rml><head><title>Panel GM</title><link type="text/rcss" href="base.rcss"/><link type="text/rcss" href="paris_gm_events.rcss"/></head><!-- bound-geometry: the event index selects one of the ten original artwork rows. --><body data-model="paris_gm_events"><div id="panel" class="paris-gm-events"><div id="frame_corner_close" class="gm-close" data-event-click="paris_gm_close"></div><input class="gm-search" type="text" maxlength="40" data-value="query"/><span class="gm-placeholder" data-if="query == ''">Buscar evento...</span><div class="gm-events"><div class="gm-event" data-for="event : events" data-style-top="event.index * 10 + '%'" data-class-selected="event.selected" data-event-click="paris_gm_select(event.index)"><span>{{event.name}}</span></div><div class="gm-empty" data-if="empty">Sin resultados</div></div><div class="gm-name">{{selected_name}}</div><div class="gm-phase">{{phase}}</div><div class="gm-participants">{{participants}} / {{maximum}}</div><div class="gm-countdown">{{countdown}}</div><div class="gm-duration">{{duration_text}}</div><div class="gm-map">Mapa: {{map_name}}</div><div class="gm-requirement">{{requirement}}</div><button class="gm-register" data-attrif-disabled="!can_start" data-event-click="paris_gm_start"></button><button class="gm-start" data-attrif-disabled="!can_register" data-event-click="paris_gm_register"></button><button class="gm-stop" data-attrif-disabled="!can_stop" data-event-click="paris_gm_stop"></button><input class="gm-announcement" type="text" maxlength="120" data-value="announcement"/><button class="gm-announce" data-attrif-disabled="!authorized" data-event-click="paris_gm_announce"></button><div class="gm-status">{{status}}</div><div class="gm-last">{{participants}} participantes registrados</div><div class="gm-refresh" data-event-click="paris_gm_refresh" title="Actualizar estado"></div><div class="gm-exit" data-event-click="paris_gm_close"></div></div></body></rml>