 void WidgetSlider::Update()
 {
+	// A bound custom property can resize the internal thumb without resizing
+	// the input. Internal elements do not participate in normal document layout.
+	if (bar && parent->GetBox().GetSize().x > 0 && parent->GetBox().GetSize().y > 0 && FormatBar())
+		ResizeProgress();
+
 	if (!std::any_of(std::begin(arrow_timers), std::end(arrow_timers), [](float timer) { return timer > 0; }))
 		return;
 
@@ -293,6 +298,7 @@ void WidgetSlider::FormatElements(const Vector2f containing_block, float slider_
 	}
 
 	FormatBar();
+	PositionBar();
 	FormatProgress();
 
 	if (parent->IsDisabled())
@@ -306,7 +312,7 @@ void WidgetSlider::FormatElements(const Vector2f containing_block, float slider_
 	}
 }
 
-void WidgetSlider::FormatBar()
+bool WidgetSlider::FormatBar()
 {
 	Box bar_box;
 	ElementUtilities::BuildBox(bar_box, parent->GetBox().GetSize(), bar);
@@ -321,10 +327,13 @@ void WidgetSlider::FormatBar()
 
 	// Set the new dimensions on the bar to re-decorate it.
 	bar_box.SetContent(bar_box_content);
+	if (bar_box == bar->GetBox())
+		return false;
 	bar->SetBox(bar_box);
 
 	// Now that it's been resized, re-position it.
 	PositionBar();
+	return true;
 }
 
