<Window x:Class="ParisLauncher.Views.WelcomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bienvenido a PARIS PROJECT" WindowStyle="None" ResizeMode="CanResize" Width="1600" Height="950" MinWidth="960" MinHeight="640" WindowStartupLocation="CenterScreen" Background="#090B0E" Foreground="#F3E9D0">
 <Border BorderBrush="#A88036" BorderThickness="1" Padding="64">
  <Grid><Grid.Background><ImageBrush ImageSource="pack://application:,,,/Launcher;component/Assets/paris-background-v2.png" Stretch="UniformToFill" Opacity="0.25"/></Grid.Background>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid MouseLeftButtonDown="DragTitle"><TextBlock Text="PARIS PROJECT   /   MU ONLINE" Foreground="#D6AB50" FontSize="20"/><Button Content="×" Click="CloseWelcome" HorizontalAlignment="Right" Padding="8,0" BorderBrush="Transparent" Background="Transparent"/></Grid>
   <Grid Grid.Row="1" VerticalAlignment="Center">
    <StackPanel x:Name="StepOne"><TextBlock Text="BIENVENIDO A" Foreground="#D6AB50" FontSize="24"/><TextBlock Text="PARIS PROJECT" FontFamily="Georgia" FontSize="76" Margin="0,14,0,30"/><TextBlock Text="Tu aventura comienza aquí." FontSize="26"/><TextBlock Text="Elige tu cliente, comprueba tu conexión y entra a MU Paris desde un solo lugar." FontSize="19" Foreground="#BBB4A5" Margin="0,16,0,0" MaxWidth="680" HorizontalAlignment="Left" TextWrapping="Wrap"/><Image Source="pack://application:,,,/Launcher;component/Assets/launcher-icon.png" Width="220" Height="220" HorizontalAlignment="Right" Margin="0,-220,40,0"/></StackPanel>
    <StackPanel x:Name="StepTwo" Visibility="Collapsed"><TextBlock Text="CÓMO QUIERES JUGAR" FontSize="44" FontWeight="SemiBold" Margin="0,0,0,40"/>
     <UniformGrid Columns="3"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="01 · OPENGL" Foreground="#D6AB50" FontSize="24"/><TextBlock Text="Cliente clásico" FontSize="24" Margin="0,24,0,15"/><TextBlock Text="La experiencia original de MU Paris. Ideal si prefieres el aspecto clásico y máxima compatibilidad con tu equipo." TextWrapping="Wrap" FontSize="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="6,0"><StackPanel><TextBlock Text="02 · VULKAN" Foreground="#D6AB50" FontSize="24"/><TextBlock Text="Cliente moderno · 64 bits" FontSize="24" Margin="0,24,0,15"/><TextBlock Text="Motor gráfico moderno para tarjetas compatibles con Vulkan. Incluye las opciones visuales del cliente renovado." TextWrapping="Wrap" FontSize="18"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="12,0,0,0"><StackPanel><TextBlock Text="03 · DIRECTX 12" Foreground="#D6AB50" FontSize="24"/><TextBlock Text="Alternativa para Windows" FontSize="24" Margin="0,24,0,15"/><TextBlock Text="El mismo cliente moderno con otro motor gráfico. Puedes cambiar entre Vulkan y DirectX 12 según la compatibilidad de tu GPU." TextWrapping="Wrap" FontSize="18"/></StackPanel></Border></UniformGrid>
    </StackPanel>
    <StackPanel x:Name="StepThree" Visibility="Collapsed"><TextBlock Text="PERSONALIZA TU EXPERIENCIA" FontSize="42" FontWeight="SemiBold"/><TextBlock Text="¿Qué te gustaría revisar primero?" Foreground="#BBB4A5" FontSize="22" Margin="0,16,0,32"/><UniformGrid Columns="3" Rows="2"><RadioButton GroupName="Goal" Style="{StaticResource Choice}" Content="Ping alto" Tag="network" Checked="ChooseGoal" Margin="8"/><RadioButton GroupName="Goal" Style="{StaticResource Choice}" Content="Tirones de conexión" Tag="network" Checked="ChooseGoal" Margin="8"/><RadioButton GroupName="Goal" Style="{StaticResource Choice}" Content="Desconexiones" Tag="network" Checked="ChooseGoal" Margin="8"/><RadioButton GroupName="Goal" Style="{StaticResource Choice}" Content="FPS bajos" Tag="performance" Checked="ChooseGoal" Margin="8"/><RadioButton GroupName="Goal" Style="{StaticResource Choice}" Content="Elegir mi cliente" Tag="client" Checked="ChooseGoal" Margin="8"/><RadioButton GroupName="Goal" Style="{StaticResource Choice}" Content="Solo quiero jugar" Tag="home" Checked="ChooseGoal" Margin="8"/></UniformGrid></StackPanel>
   </Grid>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StepLabel" Text="01 / 03" Foreground="#D6AB50" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Saltar" Click="Skip" Margin="0,0,16,0"/><Button x:Name="BackButton" Grid.Column="2" Content="Atrás" Click="Back" Margin="0,0,16,0" Visibility="Collapsed"/><Button x:Name="NextButton" Grid.Column="3" Content="SIGUIENTE →" Click="Next" Background="#CBA451" Foreground="#15120B" Padding="36,18"/></Grid>
  </Grid>
 </Border>
</Window>

