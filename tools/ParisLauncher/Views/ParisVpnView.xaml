<UserControl x:Class="ParisLauncher.Views.ParisVpnView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="VpnChoice" TargetType="RadioButton" BasedOn="{StaticResource Choice}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="#181A1B" BorderBrush="#514630"
                                BorderThickness="1" CornerRadius="10" Padding="18,12">
                            <DockPanel>
                                <Grid DockPanel.Dock="Right" Width="20" Height="20" Margin="12,0,0,0">
                                    <Ellipse Stroke="#A1A1A1" StrokeThickness="2"/>
                                    <Ellipse x:Name="Selected" Fill="#F1CA70" Margin="5" Visibility="Collapsed"/>
                                </Grid>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="#EBD08B"/>
                                <Setter TargetName="Card" Property="Background" Value="#282319"/>
                                <Setter TargetName="Selected" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="30,12,30,24">
            <DockPanel Margin="0,0,0,8">
                <Border DockPanel.Dock="Right" CornerRadius="6" Padding="12,5"
                        BorderBrush="#D6AB50" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AccessBadge" Text="ACCESO VIP" Foreground="#EBD08B" FontWeight="SemiBold"/>
                </Border>
                <TextBlock FontSize="36" FontWeight="Bold" Foreground="#F4F4F4">
                    <Run Text="VPN "/><Run Text="Paris Project" Foreground="#EBD08B"/>
                </TextBlock>
            </DockPanel>
            <TextBlock Text="Elige una región para tu conexión." Foreground="#D7DCE3" FontSize="17" Margin="0,0,0,18"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="57*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="43*"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="10" BorderBrush="#403725" BorderThickness="1" Background="#131517">
                    <StackPanel>
                        <Image Source="../Assets/vpn-paris.png" Stretch="Uniform" MaxHeight="365"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Border BorderBrush="#B74B42" BorderThickness="1" CornerRadius="8"
                                Padding="18,8" Margin="0,4,0,12" HorizontalAlignment="Center">
                            <TextBlock Text="DESCONECTADO" Foreground="#F4D7D4" FontSize="20" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <TextBlock Text="Activar VPN" Foreground="#D7DCE3" FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ToggleButton IsEnabled="False" AutomationProperties.Name="Activar VPN">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#26292F" BorderBrush="#656A73" BorderThickness="1" CornerRadius="15" Padding="4,2,9,2">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Fill="#D7DCE3" Width="22" Height="22" Margin="0,0,8,0"/>
                                                <TextBlock Text="OFF" Foreground="#BDC2CB" VerticalAlignment="Center" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <ItemsControl Grid.Column="2" x:Name="Regions">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource VpnChoice}" GroupName="VpnRegion" Tag="{Binding Name}"
                                         AutomationProperties.Name="{Binding Name}" IsChecked="{Binding Default, Mode=OneTime}"
                                         Checked="RegionChecked" Margin="0,0,0,12" MinHeight="75">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="42" Height="42" CornerRadius="21" Margin="0,0,16,0"
                                            RenderOptions.BitmapScalingMode="HighQuality">
                                        <Border.Background><ImageBrush ImageSource="{Binding Flag}" Stretch="UniformToFill"/></Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontSize="23" FontWeight="SemiBold"/>
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <Border CornerRadius="8" BorderBrush="#55472E" BorderThickness="1" Background="#17191C" Padding="16" Margin="0,16,0,0">
                <WrapPanel>
                    <TextBlock x:Name="SelectedRegion" Foreground="#EBD08B" FontSize="16" Margin="0,0,24,0"/>
                    <TextBlock x:Name="ConnectionNote" Foreground="#D7DCE3" FontSize="16" Text="Configuración de nodos pendiente."/>
                </WrapPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
