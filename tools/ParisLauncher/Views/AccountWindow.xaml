<Window x:Class="ParisLauncher.Views.AccountWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PARIS PROJECT — Acceso" WindowStyle="None" ResizeMode="CanResize" Width="1500" Height="900" MinWidth="950" MinHeight="680" Background="#090B0E" Foreground="#F3E9D0" WindowStartupLocation="CenterScreen" Loaded="LoadedAccount">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></WindowChrome.WindowChrome>
 <Border BorderBrush="#A88036" BorderThickness="1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Grid.ColumnSpan="2" VerticalAlignment="Top" Height="40" Panel.ZIndex="9" MouseLeftButtonDown="DragTitle"><TextBlock Text="PARIS PROJECT" Margin="18,10" Foreground="#D6AB50"/><Button Content="—" Click="MinimizeAccount" HorizontalAlignment="Right" Width="40" Margin="0,0,40,0" Padding="0" BorderBrush="Transparent" Background="Transparent"/><Button Content="×" Click="CloseAccount" HorizontalAlignment="Right" Width="40" Padding="0" BorderBrush="Transparent" Background="Transparent"/></Grid>
  <Border><Border.Background><ImageBrush ImageSource="pack://application:,,,/Launcher;component/Assets/paris-background-v2.png" Stretch="UniformToFill" AlignmentX="Right" Opacity="0.42"/></Border.Background><StackPanel VerticalAlignment="Center" Margin="55"><Image Source="pack://application:,,,/Launcher;component/Assets/launcher-icon.png" Width="260" Height="260"/><TextBlock Text="PARIS PROJECT" Foreground="#E7C57B" FontSize="48" FontFamily="Georgia" HorizontalAlignment="Center" Margin="0,20"/><TextBlock Text="Tu aventura comienza aquí." FontSize="24" HorizontalAlignment="Center" Margin="0,45,0,0"/></StackPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><StackPanel Margin="64,65" VerticalAlignment="Center" MaxWidth="480">
   <TextBlock x:Name="Heading" Text="Inicia sesión" FontSize="40" FontWeight="SemiBold"/><TextBlock Text="Usa tu cuenta del juego MU Paris." Style="{StaticResource Muted}" FontSize="18" Margin="0,12,0,24"/>
   <TextBlock Text="Usuario" Foreground="#D6AB50"/><TextBox x:Name="LoginName" MaxLength="10" FontSize="20" Padding="14" Margin="0,8,0,18"/>
   <StackPanel x:Name="EmailPanel" Visibility="Collapsed"><TextBlock Text="Correo electrónico" Foreground="#D6AB50"/><TextBox x:Name="Email" MaxLength="254" FontSize="20" Padding="14" Margin="0,8,0,18"/></StackPanel>
   <TextBlock Text="Contraseña" Foreground="#D6AB50"/><PasswordBox x:Name="Password" MaxLength="20" FontSize="20" Padding="14" Margin="0,8,0,18"/>
   <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed"><TextBlock Text="Confirmar contraseña" Foreground="#D6AB50"/><PasswordBox x:Name="ConfirmPassword" MaxLength="20" FontSize="20" Padding="14" Margin="0,8,0,18"/><CheckBox x:Name="AcceptTerms" Content="Acepto las reglas del servidor y el uso de mi correo para esta cuenta." Foreground="#D6CDBA" Margin="0,0,0,18"/><TextBlock Text="Usuario: 3–10 caracteres. Contraseña: 3–20 caracteres. Usa letras, números o símbolos ASCII." TextWrapping="Wrap" Foreground="#AAA18F" Margin="0,0,0,16"/></StackPanel>
   <CheckBox x:Name="RememberSession" Content="Recordar sesión en este equipo" Foreground="#D6CDBA" FontSize="15" Margin="0,0,0,20"/>
   <TextBlock x:Name="ErrorMessage" Foreground="#EFBC69" TextWrapping="Wrap" Margin="0,0,0,14"/>
   <Button x:Name="Submit" Content="INICIAR SESIÓN" Click="SubmitAccount" Background="#D6AB50" Foreground="#14110A" FontSize="20" Padding="22,18"/>
   <Button x:Name="SwitchMode" Content="¿No tienes cuenta? Crear cuenta" Click="ToggleMode" Margin="0,18,0,0" BorderBrush="Transparent"/>
   <TextBlock Text="Nunca guardamos tu contraseña en el launcher. La sesión recordada queda protegida por Windows." Style="{StaticResource Muted}" Margin="0,24,0,0"/>
  </StackPanel></ScrollViewer>
 </Grid></Border>
</Window>

