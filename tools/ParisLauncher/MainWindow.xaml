            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Cliente Clásico existente" FontFamily="Georgia" FontSize="18"/><TextBlock Text="Selecciona Jugar.exe o Main.exe de un cliente Clásico ya instalado." Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                <Button Grid.Column="1" Content="Seleccionar…" Click="ChooseClassic" Padding="14,7" FontSize="12" VerticalAlignment="Center" Margin="14,0,0,0"/>
              </Grid>
            </Border>
            <Button Content="Ver bienvenida y explicación de clientes" Click="ShowGuide" HorizontalAlignment="Left" Margin="0,14"/><TextBlock Text="Mantén Shift al abrir el launcher para volver a elegir el modo de juego." Foreground="#797D78" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>
        </ScrollViewer></Grid>

        <views:TrafficLimiterView x:Name="TrafficPanel" Grid.Row="1" Visibility="Collapsed"/>
        <!-- ===== BARRA INFERIOR: ACTUALIZACIÓN Y JUGAR ===== -->
        <Border Grid.Row="2" Background="#0A0B0C" BorderBrush="#3F3424" BorderThickness="0,1,0,0" Padding="30,14,30,16">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
              <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateStatus" Text="Preparando el cliente…" FontSize="11" Foreground="#C9B890" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="UpdatePercent" Grid.Column="1" Text="0%" Foreground="#D9B366" FontSize="11" Margin="8,0,0,0"/></Grid>
              <ProgressBar x:Name="UpdateBar" Height="7" Foreground="#D8B261" Background="#25282A" BorderThickness="0" Minimum="0" Maximum="100"/>
            </StackPanel>
            <CheckBox x:Name="Remember" Grid.Column="1" Content="Recordar mi elección" Foreground="#D4CDBE" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0"/>
            <Button Grid.Column="2" Content="SALIR" Click="ExitClick" Padding="19,10" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <Button x:Name="Play" Grid.Column="3" Content="JUGAR" Click="PlayClick" Background="#C69B4A" Foreground="#17130A" FontFamily="Georgia" FontSize="20" FontWeight="Bold" Padding="44,12" IsEnabled="False" VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>


