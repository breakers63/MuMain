<Window x:Class="ParisLauncher.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Paris Project · Launcher" Width="1100" Height="800" MinWidth="820" MinHeight="650" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize" Background="#101214" Foreground="#E8E1D2" FontFamily="Segoe UI" Loaded="WindowLoaded" Closing="WindowClosing">
  <Border BorderBrush="#AF8A46" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="37*"/><ColumnDefinition Width="63*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" BorderBrush="#655133" BorderThickness="0,0,1,0">
        <Border.Background><ImageBrush ImageSource="Assets/launcher-art.png" Viewbox="0.007,0.017,0.515,0.945" ViewboxUnits="RelativeToBoundingBox" Stretch="Fill"/></Border.Background>
      </Border>
      <Grid Grid.Column="1" Margin="30,32,30,22">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,5,0">
          <StackPanel>
            <TextBlock Text="Elige cómo quieres jugar" FontFamily="Georgia" FontSize="30" Foreground="#E9C77E" Margin="0,9,0,8"/>
            <TextBlock Text="Una sola instalación. Elige cómo entrar y guarda tu preferencia." Foreground="#A9A69C" FontSize="13" Margin="0,0,0,22" TextWrapping="Wrap"/>
            <RadioButton x:Name="Classic" GroupName="Client" Style="{StaticResource Choice}" Checked="ModeChanged" Margin="0,0,0,10">
              <StackPanel><TextBlock Text="Clásico" FontFamily="Georgia" FontSize="23"/><TextBlock Text="OPENGL · EXPERIENCIA ORIGINAL" Foreground="#C8A65F" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,7"/><TextBlock Text="El MU Paris de siempre, con su cliente clásico." TextWrapping="Wrap" Foreground="#AFAEA7" FontSize="13"/></StackPanel>
            </RadioButton>
            <RadioButton x:Name="Modern" GroupName="Client" Style="{StaticResource Choice}" Checked="ModeChanged" IsChecked="True" Margin="0,0,0,19">
              <StackPanel><TextBlock Text="Moderno" FontFamily="Georgia" FontSize="23"/><TextBlock Text="64 BITS · GRÁFICOS RENOVADOS" Foreground="#D9B367" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,7"/><TextBlock Text="Opciones de calidad HD y motores gráficos modernos." TextWrapping="Wrap" Foreground="#BFB8AA" FontSize="13"/></StackPanel>
            </RadioButton>
            <TextBlock Text="MOTOR GRÁFICO" Foreground="#D3AE64" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border BorderBrush="#655236" BorderThickness="1" Padding="3" CornerRadius="5"><UniformGrid x:Name="Engines" Columns="2"><RadioButton x:Name="Vulkan" GroupName="Engine" Content="Vulkan" IsChecked="True" Style="{StaticResource Engine}"/><RadioButton x:Name="DirectX" GroupName="Engine" Content="DirectX 12" Style="{StaticResource Engine}"/></UniformGrid></Border>
            <TextBlock x:Name="EngineNote" Text="El modo Clásico utiliza OpenGL." Foreground="#8F938E" FontSize="11" Margin="0,7,0,12"/>
            <Expander Header="Opciones del launcher" Foreground="#D8B66C" FontSize="12" Margin="0,0,0,12">
              <StackPanel Margin="0,8,0,0"><TextBlock Text="La calidad visual y los climas se ajustan dentro del juego." TextWrapping="Wrap" FontSize="12" Foreground="#AAA69A"/><WrapPanel><Button Content="Carpeta de instalación…" Click="ChooseInstallFolder" Margin="0,9,8,0" Padding="12,6" FontSize="11"/><Button Content="Cliente Clásico existente…" Click="ChooseClassic" Margin="0,9,0,0" Padding="12,6" FontSize="11"/></WrapPanel></StackPanel>
            </Expander>
            <Border Background="#16191B" BorderBrush="#463E2E" BorderThickness="1" CornerRadius="5" Padding="14,11"><StackPanel><TextBlock Text="TARJETA GRÁFICA DETECTADA" Foreground="#C4A565" FontSize="10" Margin="0,0,0,5"/><TextBlock x:Name="GpuName" Text="Detectando…" FontSize="14" TextWrapping="Wrap"/><TextBlock x:Name="GpuMemory" Foreground="#92958D" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Margin="0,16,0,0">
          <Border Background="#403623" Height="1" Margin="0,0,0,14"/>
          <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="UpdateStatus" Text="Preparando el cliente…" FontSize="11" Foreground="#C9B890" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="UpdatePercent" Grid.Column="1" Text="0%" Foreground="#D9B366" FontSize="11" Margin="8,0,0,0"/></Grid>
          <ProgressBar x:Name="UpdateBar" Height="7" Foreground="#D8B261" Background="#25282A" BorderThickness="0" Minimum="0" Maximum="100"/>
          <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox x:Name="Remember" Content="Recordar mi elección" Foreground="#D4CDBE" FontSize="12" VerticalAlignment="Center"/><Button Grid.Column="1" Content="SALIR" Click="ExitClick" Padding="19,10" Margin="8,0,10,0"/><Button x:Name="Play" Grid.Column="2" Content="JUGAR" Click="PlayClick" Background="#C69B4A" Foreground="#17130A" FontFamily="Georgia" FontSize="18" FontWeight="Bold" Padding="37,10" IsEnabled="False"/></Grid>
          <TextBlock Text="Mantén Shift al abrir para cambiar de modo." FontSize="10" Foreground="#797D78" TextAlignment="Right" Margin="0,10,0,0"/>
        </StackPanel>
      </Grid>
      <Grid Grid.ColumnSpan="2" VerticalAlignment="Top" Height="28" MouseLeftButtonDown="DragTitle"><Button Content="—" Click="MinimizeClick" HorizontalAlignment="Right" Width="35" Margin="0,0,36,0" Padding="0" BorderBrush="Transparent" Background="Transparent"/><Button Content="×" Click="ExitClick" HorizontalAlignment="Right" Width="35" Padding="0" FontSize="23" BorderBrush="Transparent" Background="Transparent"/></Grid>
    </Grid>
  </Border>
</Window>
