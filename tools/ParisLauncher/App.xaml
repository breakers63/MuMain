<Application x:Class="ParisLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#11151B"/><Setter Property="Foreground" Value="#F3E9D0"/><Setter Property="BorderBrush" Value="#66512E"/><Setter Property="CaretBrush" Value="#E6BC64"/><Setter Property="SelectionBrush" Value="#695027"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#11151B"/><Setter Property="Foreground" Value="#F3E9D0"/><Setter Property="BorderBrush" Value="#66512E"/><Setter Property="CaretBrush" Value="#E6BC64"/></Style>
    <Style x:Key="ToggleCard" TargetType="CheckBox"><Setter Property="ContentTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="16"/></DataTemplate></Setter.Value></Setter><Setter Property="Foreground" Value="#E8E1D2"/><Setter Property="FontSize" Value="16"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><Border Background="#1B1D20" BorderBrush="#514229" BorderThickness="1" CornerRadius="10" Padding="18" MinHeight="105"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0"/><Border x:Name="Track" Grid.Column="1" Width="36" Height="21" Background="#44464B" CornerRadius="11" VerticalAlignment="Center"><Ellipse x:Name="Dot" Width="15" Height="15" Fill="#ECE7DB" HorizontalAlignment="Left" Margin="3"/></Border></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#BE913D"/><Setter TargetName="Dot" Property="HorizontalAlignment" Value="Right"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="8"/><Setter Property="Background" Value="#17191C"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#AD853E" CornerRadius="4" Margin="1"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
    <SolidColorBrush x:Key="Gold" Color="#D9B366"/>
    <Style TargetType="TextBlock"><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EACD8D"/><Setter Property="Background" Value="#111213"/><Setter Property="BorderBrush" Value="#8A703F"/><Setter Property="Padding" Value="20,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFE0A0"/><Setter TargetName="Edge" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#EAE3D4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#181A1C"/><Setter Property="BorderBrush" Value="#554A36"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="7" Padding="19,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,5,0,0"><Ellipse Stroke="#8C877B" StrokeThickness="2"/><Ellipse x:Name="Dot" Fill="#F1CC77" Margin="5" Visibility="Collapsed"/></Grid><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#E4BF6C"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Background" Value="#282319"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#E4BF6C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Engine" TargetType="RadioButton" BasedOn="{StaticResource Choice}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="EngineBorder" Background="#111416" CornerRadius="4" Padding="15,10"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="EngineBorder" Property="Background" Value="#A9823F"/><Setter Property="Foreground" Value="#FFF7E7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="EngineBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#BDB4A2"/><Setter Property="FontSize" Value="15"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Item" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="16,11"><Grid><Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-16,-3,0,-3" Background="#E4BF6C" CornerRadius="2" Visibility="Collapsed"/><ContentPresenter VerticalAlignment="Center"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Item" Property="Background" Value="#1B1913"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Item" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#806936"/><GradientStop Color="#433920" Offset="0.55"/><GradientStop Color="#282319" Offset="1"/></LinearGradientBrush></Setter.Value></Setter><Setter TargetName="Item" Property="BorderBrush" Value="#CCAD63"/><Setter TargetName="Bar" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="#F1CC77"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#15171A"/><Setter Property="BorderBrush" Value="#3B3325"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="18,16"/>
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#C4A565"/><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Metric" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F3E6C8"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="30"/>
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E9C77E"/><Setter Property="FontFamily" Value="Georgia"/><Setter Property="FontSize" Value="28"/><Setter Property="Margin" Value="0,0,0,6"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#A9A69C"/><Setter Property="FontSize" Value="13"/><Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
  </Application.Resources>
</Application>

