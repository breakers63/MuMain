<Application x:Class="ParisLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Gold" Color="#D9B366"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8E1D2"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EACD8D"/><Setter Property="Background" Value="#111213"/><Setter Property="BorderBrush" Value="#8A703F"/><Setter Property="Padding" Value="20,10"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Edge" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#FFE0A0"/><Setter TargetName="Edge" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Choice" TargetType="RadioButton">
      <Setter Property="Foreground" Value="#EAE3D4"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#181A1C"/><Setter Property="BorderBrush" Value="#554A36"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}" CornerRadius="7" Padding="19,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,5,0,0"><Ellipse Stroke="#8C877B" StrokeThickness="2"/><Ellipse x:Name="Dot" Fill="#F1CC77" Margin="5" Visibility="Collapsed"/></Grid><ContentPresenter Grid.Column="1"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#E4BF6C"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Background" Value="#282319"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#E4BF6C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Engine" TargetType="RadioButton" BasedOn="{StaticResource Choice}">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="EngineBorder" Background="#111416" CornerRadius="4" Padding="15,10"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="EngineBorder" Property="Background" Value="#A9823F"/><Setter Property="Foreground" Value="#FFF7E7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="EngineBorder" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
